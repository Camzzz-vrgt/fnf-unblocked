    override function buildStage():Void
	{
		super.buildStage();

        game = PlayState.instance;
		dad = game.currentStage.getDad();
		bf = game.currentStage.getBoyfriend();
		gf = game.currentStage.getGirlfriend();
	    game.comboPopUps.offsets = [550, 350];

		game.healthBar.createFilledBar(0xFF000000, 0xFFFFFFFF);

        forest = new FunkinSprite(0, 0);
		forest.loadTexture('stages/dayforest/forest');
        //forest.scale.set(1.85,1.85);
        forest.antialiasing = true;
		add(forest);

        forest2 = new FunkinSprite(0, 0);
		forest2.loadTexture('stages/dayforest/forest2');
        //forest.scale.set(1.85,1.85);
        forest2.visible = false;
		add(forest2);

        forest3 = new FunkinSprite(0, 0);
		forest3.loadTexture('stages/dayforest/forest3');
        //forest.scale.set(1.85,1.85);
        forest3.alpha = 0.4;
        forest3.visible = false;
		add(forest3);

        forest4 = new FunkinSprite(0, 0);
		forest4.loadTexture('stages/dayforest/forest4');
        //forest.scale.set(1.85,1.85);
        forest4.alpha = 0.4;
        forest4.visible = false;
		add(forest4);

        forest5 = new FunkinSprite(0, 0);
		forest5.loadTexture('stages/dayforest/forest4');
        //forest.scale.set(1.85,1.85);
        forest5.alpha = 0.3;
        forest5.visible = false;
		add(forest5);

        goodending = new FunkinSprite(0, 0);
		goodending.loadTexture('stages/dayforest/goodending');
        //goodending.scale.set(1.85,1.85);
        goodending.antialiasing = true;
        goodending.visible = false;
		add(goodending);

        badending = new FunkinSprite(0, 0);
		badending.loadTexture('stages/dayforest/badending');
