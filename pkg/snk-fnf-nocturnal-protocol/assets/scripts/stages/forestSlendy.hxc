        custardText.cameras = [game.camHUD];
        custardText.antialiasing = false;
        custardText.updateHitbox();
        custardText.alpha = 0;
        custardText.x = (FlxG.width / 2) - (custardText.width / 2) + cutoutX;
        custardText.y = (FlxG.height / 2) - (custardText.height / 2) + cutoutY;
        custardText.y += 150;
        PlayState.instance.add(custardText);

        tinkyscreamer = new FunkinSprite(0, 0);
        tinkyscreamer.loadTexture('stages/dayforest/image3');
        tinkyscreamer.cameras = [game.camCutscene];
        tinkyscreamer.scale.set(2.7, 2.7);
        tinkyscreamer.updateHitbox();
        tinkyscreamer.x = (FlxG.width / 2) - (tinkyscreamer.width / 2) + cutoutX;
        tinkyscreamer.y = (FlxG.height / 2) - (tinkyscreamer.height / 2) + cutoutY;
        tinkyscreamer.zIndex = 100000;
        tinkyscreamer.alpha = 0;
        tinkyscreamer.visible = true;
        tinkyscreamer.antialiasing = true;
        PlayState.instance.add(tinkyscreamer);

        tinkyscreamer2 = new FunkinSprite(0, 0);
        tinkyscreamer2.loadTexture('stages/dayforest/tinky2');
        tinkyscreamer2.cameras = [game.camCutscene];
        tinkyscreamer2.scale.set(0.6, 0.6);
        tinkyscreamer2.updateHitbox();
        tinkyscreamer2.x = (FlxG.width / 2) - (tinkyscreamer2.width / 2) + cutoutX;
        tinkyscreamer2.y = (FlxG.height / 2) - (tinkyscreamer2.height / 2) + cutoutY;
        tinkyscreamer2.zIndex = 100000;
        tinkyscreamer2.alpha = 1;
        tinkyscreamer2.visible = false;
        tinkyscreamer2.antialiasing = true;
        PlayState.instance.add(tinkyscreamer2);

        sebas = new FunkinSprite(2500, 450);
        sebas.loadSparrow('stages/mall/npcs/Sebas-random-walk');
        sebas.scale.set(0.8, 0.8);
        sebas.animation.addByPrefix('idle', 'idle', 12, true);
        sebas.animation.play('idle');
        add(sebas);

        blackScreen = new FunkinSprite(0, 10).makeSolidColor(FlxG.width * 1.2, FlxG.height * 1.2, 0xFF000000);
        blackScreen.cameras = [game.camCutscene];
        // blackScreen.screenCenter();
        add(blackScreen);

    }

    function onCreate(event:ScriptEvent)
    {
        super.onCreate(event);
        game = PlayState.instance;
    }

    public function onSongStart(event:ScriptEvent)
    {
        super.onSongStart(event);
        FlxTween.tween(blackScreen, {alpha: 0}, 5);
    }




    function onSongLoaded(e:Dynamic)
    {
        super.onSongLoaded(e);

        var bfFocus = PlayState.instance.currentStage.getBoyfriend().cameraFocusPoint;
        game.cancelCameraFollowTween();
        game.cameraFollowPoint.setPosition(bfFocus.x, bfFocus.y);
        game.resetCamera(true, false, false);

        game.iconP2.alpha = 0;
        PlayState.instance.currentStage.getBoyfriend().alpha = 0;
        PlayState.instance.currentStage.getDad().alpha = 0;
        PlayState.instance.currentStage.getBoyfriend().scale.set(0.4,0.4);
        game.opponentStrumline.x -= 100000;


    }


