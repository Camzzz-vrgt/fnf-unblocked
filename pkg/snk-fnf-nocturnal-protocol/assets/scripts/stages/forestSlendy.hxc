    function onSongRetry(){
      super.onSongRetry();

        papillaCounter = 0;

        forest.visible = true;
        forest.alpha = 1;
        blackScreen.alpha = 1;
        forest2.visible = false;
        forest3.visible = false;
        forest4.visible = false;
        forest5.visible = false;
        goodending.visible = false;
        badending.visible = false;
        papilla.visible = false;
        guardianCrack.visible = false;
        effectHUD.visible = false;
        seunio.visible = true;
        tinkyscreamer2.visible = false;

        tinkyscreamer.alpha = 0;
        custardText.alpha = 0;

        for (s in screamerFrames) s.visible = false;
        lastImage = 0;

        PlayState.instance.currentStage.getBoyfriend().alpha = 0;
        PlayState.instance.currentStage.getBoyfriend().scale.set(0.4, 0.4);
        PlayState.instance.currentStage.getDad().alpha = 0;

        camAngle = false;
        swingEnabled = false;
        game.camGame.angle = 0;
        game.opponentStrumline.x -= 100000;
        game.iconP2.alpha = 0;
}

    public override function onSongEvent(scriptEvent:SongEventScriptEvent)
	{
		super.onSongEvent(scriptEvent);
		if (scriptEvent.eventData.eventKind == "TinkyScreamer")
		{
			tinkyscreamer.alpha = 1;
            new FlxTimer().start(0.05, function(tmr:FlxTimer) {
                tinkyscreamer.alpha = 0.0001;
                });
		}
       if (scriptEvent.eventData.eventKind == "Add Camera Zoom")
        {
        game.cameraBopMultiplier = game.cameraBopIntensity;
        game.camHUD.zoom += game.hudCameraZoomIntensity * game.defaultHUDCameraZoom;
        }

         if (scriptEvent.eventData.eventKind == "CharSwing")
    {
        if (scriptEvent.eventData.getString('value1') == 'on')
        {
            swingEnabled = true;
            duration = Conductor.instance.beatLengthMs / 1000;
        }
        else
        {
            swingEnabled = false;
            game.currentStage.getBoyfriend().angle = 0;
            game.currentStage.getDad().angle = 0;
            forest4.angle = 0;
        }
    }
    if (scriptEvent.eventData.eventKind == "PopUp")
    {
        var imageName:String = scriptEvent.eventData.getString('value1');

         if (popupTween != null) popupTween.cancel();

        if (popupImage != null)
        {
            PlayState.instance.remove(popupImage);
            popupImage = null;
        }

        popupImage = new FunkinSprite();
        popupImage.loadTexture('stages/dayforest/' + imageName);
        popupImage.cameras = [game.camHUD];
        popupImage.scale.set(2.7, 2.7);
        popupImage.updateHitbox();
        popupImage.x = (FlxG.width / 2) - (popupImage.width / 2) + cutoutX;
        popupImage.y = (FlxG.height / 2) - (popupImage.height / 2) + cutoutY;
        popupImage.alpha = 1;
        PlayState.instance.add(popupImage);

        FlxTween.tween(popupImage.scale, {x: 3.9, y: 3.9}, 1, {ease: FlxEase.quadOut});
        popupTween = FlxTween.tween(popupImage, {alpha: 0}, 1, {
            ease: FlxEase.linear,
            onComplete: function(_) {
                PlayState.instance.remove(popupImage);
                popupImage = null;
            }
        });
    }

	}

    public override function onNoteHit(event) {
		super.onNoteHit(event);

        if (!event.note.noteData.getMustHitNote() ) {

          if(game.health > 0.1)  game.health -= 0.02;



          }
            if (event.note.noteData.getMustHitNote() ) {
           switch (event.note.noteData.kind)
          {
            case "papilla":
                papillaCounter++;
                custardText.alpha = 1;
                custardText.text = 'a player has collected ' + papillaCounter + '/10 custards';
                new FlxTimer().start(1.5, function(tmr:FlxTimer) {
                    FlxTween.tween(custardText, {alpha: 0}, 1);
                });
          }
        }

    }


    function onStepHit(event:SongTimeScriptEvent):Void {
    super.onStepHit(event);
    curStep = event.step;


    switch (curStep) {


        case 32:
            seunio.visible = false;

		case 64:
            FlxTween.tween(PlayState.instance.currentStage.getBoyfriend(), {alpha: 1}, (Conductor.instance.stepLengthMs / 1000) * (88 - 64));
            FlxTween.tween(PlayState.instance.currentStage.getBoyfriend().scale, {x: 1.8, y: 1.8}, (Conductor.instance.stepLengthMs / 1000) * (312 - 64));
            camAngle = true;
        case 308:
            PlayState.instance.camHUD.fade(0xFF000000, 1);

        case 313:
			game.tweenScrollSpeed(2, 0, null, ['playerStrumline', 'opponentStrumline']);

        case 320:
            PlayState.instance.camHUD.fade(0xFF000000, 0.001, true);
            forest.alpha = 0;
            camAngle = false;
        case 322:
            PlayState.instance.camHUD.fade(0xFF000000, 0.4);

        case 328:
            PlayState.instance.camHUD.fade(0xFF000000, 0.5, true);

        case 336:
            PlayState.instance.camHUD.fade(0xFF000000, 1, true);
            forest2.visible = true;
		    game.healthBar.createFilledBar(0xFF6003B9, 0xFFFFFFFF);
            PlayState.instance.iconP2.alpha = 1;
            PlayState.instance.currentStage.getDad().alpha = 1;


        case 464:
            PlayState.instance.camHUD.fade(0xFF000000, 0.5);

        case 474:
			game.tweenScrollSpeed(2.3, 0, null, ['playerStrumline', 'opponentStrumline']);

        case 479:
            PlayState.instance.camHUD.fade(0xFF000000, 1, true);



        case 606:
            PlayState.instance.camHUD.fade(0xFF000000, 0.2);
			game.tweenScrollSpeed(2.55, 0, null, ['playerStrumline', 'opponentStrumline']);

        case 608:
            PlayState.instance.camHUD.fade(0xFF000000, 0.2, true);
            forest2.visible = false;
            effectHUD.visible = true;
            for (s in screamerFrames) s.visible = true;

        case 609:
            FlxTween.tween(PlayState.instance.currentStage.getDad().scale, {x: 0.6, y: 0.6}, (Conductor.instance.stepLengthMs / 1000) * (610 - 609));
            PlayState.instance.currentStage.getDad().x += 100;
        case 612:
            FlxTween.tween(PlayState.instance.currentStage.getDad().scale, {x: 1.2, y: 1.2}, (Conductor.instance.stepLengthMs / 1000) * (672 - 612));
            FlxTween.tween(PlayState.instance.currentStage.getDad(), {x: PlayState.instance.currentStage.getDad().x - 100}, (Conductor.instance.stepLengthMs / 1000) * (672 - 612));

        case 734:
            PlayState.instance.camHUD.fade(0xFF000000, 0.01);

        case 736:
            PlayState.instance.camHUD.fade(0xFF000000, 0.5, true);
            forest3.visible = true;
            effectHUD.visible = false;
            for (s in screamerFrames) s.visible = false;
			game.tweenScrollSpeed(1.9, 0, null, ['playerStrumline', 'opponentStrumline']);


        case 862:
            PlayState.instance.camHUD.fade(0xFF000000, 0.2);
            forest3.visible = false;

        case 865:
            PlayState.instance.camHUD.fade(0xFF000000, 0.5, true);
            PlayState.instance.currentStage.getBoyfriend().alpha = 0;

        case 894:
            PlayState.instance.camHUD.fade(0xFF000000, 0.1);

        case 896:
            PlayState.instance.camHUD.fade(0xFF000000, 0.5, true);
            PlayState.instance.currentStage.getDad().alpha = 0;
            PlayState.instance.currentStage.getBoyfriend().alpha = 1;

        case 926:
            PlayState.instance.camHUD.fade(0xFF000000, 0.1);

        case 928:
            PlayState.instance.camHUD.fade(0xFF000000, 0.5, true);
            PlayState.instance.currentStage.getDad().alpha = 1;
            PlayState.instance.currentStage.getBoyfriend().alpha = 0;

        case 958:
            PlayState.instance.camHUD.fade(0xFF000000, 0.1);

        case 960:
            PlayState.instance.camHUD.fade(0xFF000000, 0.5, true);
            PlayState.instance.currentStage.getDad().alpha = 0;
            PlayState.instance.currentStage.getBoyfriend().alpha = 1;

        case 990:
            PlayState.instance.camHUD.fade(0xFF000000, 0.1);

        case 992:
            PlayState.instance.camHUD.fade(0xFF000000, 0.5, true);
            forest5.visible = true;
            papilla.visible = true;
            papilla.scale.set(0.2,0.2);
            FlxTween.tween(papilla.scale, {x: 1, y: 1}, (Conductor.instance.stepLengthMs / 1000) * (1100 - 992));
			game.tweenScrollSpeed(1.8, 3, null, ['playerStrumline', 'opponentStrumline']);

            PlayState.instance.currentStage.getDad().alpha = 0;
            PlayState.instance.currentStage.getBoyfriend().alpha = 0;

        case 1103:
            FlxTween.tween(papilla, {y: papilla.y + 400}, (Conductor.instance.stepLengthMs / 1000) * (1108 - 1103));

        case 1118:
            PlayState.instance.camHUD.fade(0xFF000000, 0.01);
            tinkyscreamer2.visible = true;
            FlxTween.tween(tinkyscreamer2.scale, {x: 6, y: 6}, 0.5, {ease: FlxEase.quintIn});

        case 1120:
            PlayState.instance.camHUD.fade(0xFF000000, 0.5, true);
            for (s in screamerFrames) s.visible = true;
            forest5.visible = false;
			game.tweenScrollSpeed(2.6, 0, null, ['playerStrumline', 'opponentStrumline']);
            effectHUD.visible = true;
            PlayState.instance.currentStage.getDad().x -= 100;

        case 1121:
            tinkyscreamer2.visible = false;


        case 1122:
            FlxTween.tween(PlayState.instance.currentStage.getDad().scale, {x: 0.05, y: 0.05}, (Conductor.instance.stepLengthMs / 1000) * (12));

        case 1126:
            FlxTween.tween(PlayState.instance.currentStage.getDad().scale, {x: 1.2, y: 1.2}, (Conductor.instance.stepLengthMs / 1000) * (1184 - 1124));


        case 1247:
            PlayState.instance.camHUD.fade(0xFF000000, 0.01);

        case 1248:
            PlayState.instance.camHUD.fade(0xFF000000, 0.5, true);
            effectHUD.visible = false;
            for (s in screamerFrames) s.visible = false;
            PlayState.instance.currentStage.getDad().alpha = 0;
            PlayState.instance.currentStage.getBoyfriend().alpha = 0;
            if(papillaCounter == 10)
            {
                guardianCrack.visible = true;
                new FlxTimer().start(3, function(tmr:FlxTimer) {
                guardianCrack.animation.play('walk');
                PlayState.instance.camHUD.fade(0xFF000000, 0.5);

                });
                goodending.visible = true;

            }
            else
            {
                badending.visible = true;
            }
     }
    }

    function onBeatHit(event) {
		super.onBeatHit(event);
		curBeat = event.beat;

        if (swingEnabled)
        {
        startAngle = targetAngle;
        targetAngle = -targetAngle;
        progress = 0;
        }

		if (screamerFrames.length > 0 && screamerFrames[lastImage].visible)
        {
            for (s in screamerFrames) s.visible = false;

            var nextImage = FlxG.random.int(0, 4);
            while (nextImage == lastImage) nextImage = FlxG.random.int(0, 4);
            lastImage = nextImage;

            screamerFrames[nextImage].visible = true;
        }



        switch(curBeat)
        {

         case 224:

        }


	}

    function onPause(e:Dynamic)
    {
        super.onPause(e);


    }


    function onResume(e:Dynamic)
    {
        super.onResume(e);

    }
}
