        effectHUD.cameras = [game.camHUD];
        effectHUD.scale.set(0.7, 0.5);
        effectHUD.updateHitbox();
        effectHUD.x = (FlxG.width / 2) - (effectHUD.width / 2) + cutoutX;
        effectHUD.y = (FlxG.height / 2) - (effectHUD.height / 2) + cutoutY;
        effectHUD.zIndex = 100000;
        effectHUD.visible = false;
        effectHUD.antialiasing = true;
        PlayState.instance.add(effectHUD);

        seunio = new FunkinSprite(200, 0);
