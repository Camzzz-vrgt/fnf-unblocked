        seunio.scale.set(0.7, 0.7);
        seunio.zIndex = 100;
        seunio.visible = true;
        seunio.antialiasing = true;
        PlayState.instance.add(seunio);

        custardText = new FlxText(0, 0, 0, 'a player has collected 0/10 custards');
