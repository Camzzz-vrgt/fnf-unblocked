        papilla.alpha = 1;
        papilla.visible = false;
		add(papilla);

        guardianCrack = new FunkinSprite(140, 100);
		guardianCrack.loadSparrow('stages/dayforest/guardianfinal');
		guardianCrack.animation.addByPrefix('idle', "idle0", 24, false);
		guardianCrack.animation.addByPrefix('walk', "walk0", 24, false);
        guardianCrack.animation.play('idle');
        guardianCrack.scale.set(1.4,1.4);
        guardianCrack.antialiasing = true;
        guardianCrack.visible = false;
		add(guardianCrack);


        for (i in 1...6)
        {
            var s = new FunkinSprite(0, 0);
            s.loadTexture('stages/dayforest/image' + i);
            s.cameras = [game.camHUD];
            s.scale.set(2.5, 2.5);
            s.alpha = 0.3;
            s.updateHitbox();
            s.x = (FlxG.width / 2) - (s.width / 2) + cutoutX;
            s.y = (FlxG.height / 2) - (s.height / 2) + cutoutY;
            s.zIndex = 10001;
            s.visible = false;
            s.antialiasing = true;
            PlayState.instance.add(s);
