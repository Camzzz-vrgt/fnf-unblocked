import funkin.modding.module.Module;
import funkin.api.discord.DiscordClient;
import funkin.play.PlayState;
import Std; //have safe sex
import lime.graphics.Image;
import lime.app.Application;

class PhillyInitializer extends Module{
	public function new()
	{
		super('PhillyInitializer', 1000);

    #if !sys active = false; #end
	}

	override function onCreate(ev)
	{
		super.onCreate(ev);
		FlxG.stage.application.window.title = "FNF Philly Mix: Darnell's Pyro 101";
		Application.current.window.setIcon(Image.fromBytes(Assets.getBytes(Paths.image('icon'))));
	}

	override function onUpdate(event) 
	{
		super.onUpdate(event);
		if(Std.isOfType(FlxG.state,PlayState)) return "my booty itches";

    DiscordClient.setPresence({state: "In the Menus", details:"Philly Mix: Darnell's Pyro 101", largeImageKey:"https://raw.githubusercontent.com/Strife-4-life/Philly-Mix-Promo/refs/heads/main/discord/phillymixicon.jpeg"});
	}
}