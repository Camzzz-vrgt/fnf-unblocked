import funkin.play.character.BaseCharacter;
import funkin.data.character.CharacterDataParser;
import funkin.play.PlayState;
import funkin.play.character.MultiAnimateAtlasCharacter;
import funkin.util.HapticUtil;
import funkin.graphics.shaders.AdjustColorShader;
import funkin.play.GameOverSubState;
import flixel.FlxG;
import funkin.play.character.DJCharacter;

class DJDarkCharacter extends DJCharacter
{
  function new()
  {
    super('dj-dark');
  }

  var normalChar:BaseCharacter;

  override function set_alpha(val:Float):Float
  {
    super.set_alpha(val);

    if (normalChar != null)
    {
      if (val != 1) normalChar.alpha = 1;
      else
        normalChar.alpha = 0.0001;
    }

    return val;
  }

  public override function playAnimation(name:String, restart:Bool = false, ignoreOther:Bool = false, reversed:Bool = false):Void
  {
    super.playAnimation(name, restart, ignoreOther, reversed);
    if (normalChar != null)
    {
      normalChar.playAnimation(name, restart, ignoreOther);
      normalChar.setPosition(this.x, this.y-71);
    }
  }

  public override function onSongStart(event:ScriptEvent):Void
  {
    super.onSongStart(event);
    normalChar.analyzer = analyzer;
  }

  public override function onSongRetry(event:SongRetryEvent):Void
  {
    super.onSongRetry(event);
    normalChar.analyzer = null;
    normalChar.analyzerLevelsCache = [];
  }

  public override function onSongEnd(event:ScriptEvent):Void
  {
    super.onSongEnd(event);
    normalChar.analyzer = null;
    normalChar.analyzerLevelsCache = [];
  }

  function onCreate(event:ScriptEvent)
  {
    super.onCreate(event);

    if (!this.debug)
    {
      normalChar = CharacterDataParser.fetchCharacter('dj');
      normalChar.zIndex = this.zIndex - 1;
      normalChar.alpha = 0.0001;

      currentStage.add(normalChar);
      currentStage.refresh(); // Apply z-index.
    }
  }
}
