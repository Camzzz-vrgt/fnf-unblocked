import flixel.util.FlxColor;
import flixel.tweens.FlxEase;
import flixel.FlxSprite;
import flixel.text.FlxText;
import flixel.tweens.FlxTween;
import funkin.audio.FunkinSound;
import funkin.graphics.FunkinSprite;
import funkin.ui.MusicBeatState;
import funkin.play.PlayStatePlaylist;
import funkin.save.Save;
import funkin.play.song.Song;
import flixel.FlxCamera;
import flixel.addons.display.FlxBackdrop;
import flixel.addons.transition.FlxTransitionableState;
import funkin.ui.freeplay.FreeplayState;
import funkin.ui.transition.LoadingState;
import funkin.util.Constants;
import funkin.util.TouchUtil;
import funkin.data.song.SongRegistry;
import funkin.modding.base.ScriptedMusicBeatState;
import funkin.ui.AtlasText;


class TrickyFreeplayState extends ScriptedMusicBeatState {
	public function new() {
		super();
	}

	var menuControllable:Bool = false;
	var shouldHaveTiky:Bool = false;

	var debugTester:Bool = false;

	public override function create():Void {
		super.create();

		if(FlxG.sound.music == null) FlxG.sound.playMusic(Paths.music('trickyMenuMusic/nexus_tricky'));

		songs = ["improbable-outset", "madness", "hellclown", "expurgation", "assault", "tiky"];
    	difficulties = ["easy", "normal", "hard"];
		// if (Save.instance.modOptions.exists("tikyUnlocked") && Save.instance.modOptions.get("tikyUnlocked") == true) songs.push("tiky");

		bgCamera = FlxG.camera = new FlxCamera(0, 0, FlxG.width, FlxG.height, 0);
		bgCamera.bgColor = 0xFF9d0a0a;
		FlxG.cameras.add(bgCamera);

		gridVoid = new FlxBackdrop(Paths.image('trickyMenu/main/grid'));

        vignette = FunkinSprite.create(0, 0, 'trickyMenu/main/vignette');
        vignette.blend = 9;
        vignette.setGraphicSize(FlxG.width, FlxG.height);

        box = FunkinSprite.create(0, 0, 'trickyMenu/freeplay/freeplayBox');
        box.screenCenter();

        blackFade = new FunkinSprite(0,0).makeGraphic(FlxG.width, FlxG.height, 0xFF000000);

		for (i in [gridVoid, box]) add(i);

        songSprites = [];
		hitboxes = [];

        for (i in 0...songs.length){
			if (!hasBeatenTrickyWeek() && i > 2){
				songSprite = new FunkinSprite(0, 0);
				songSprite.frames = Paths.getSparrowAtlas('trickyMenu/freeplay/coverBox');
				songSprite.setPosition(box.x + 80, songSprites[i-1].y + songSprites[i-1].height + 20);
				songSprite.animation.addByPrefix('idle', 'idle', 24, true);
				songSprite.animation.play('idle');

				var hitbox = new FlxSprite(songSprite.x + (songSprite.width * 0.5), songSprite.y).makeGraphic(songSprite.width * 0.6, songSprite.height, FlxColor.TRANSPARENT);
				add(hitbox);

				hitboxes.push(hitbox);
			} else {
				songSprite = new AtlasText(0, 0, songs[i].toUpperCase(), "trickyAlphabet");
				songSprite.scale.set(0.6, 0.6);
				songSprite.updateHitbox();
				if (i == 0) songSprite.setPosition(box.x + 130 - songSprite.width*0.5, box.y + 60);
				else songSprite.setPosition(box.x + 80 - songSprite.width*0.5, songSprites[i-1].y + songSprites[i-1].height + 40);

				songSprite.color = 0xFFff0000;

				//fucked up and evil fix because apparently updating the hitbox of an AtlasText doesn't actually work LOL

				var hitbox = new FlxSprite(songSprite.x + (songSprite.width * 0.5), songSprite.y).makeGraphic(songSprite.width * 0.6, songSprite.height, FlxColor.TRANSPARENT);
				add(hitbox);

				hitboxes.push(hitbox);
			}
            songSprites.push(songSprite);
			add(songSprite);
        }

		if (!hasBeatenTrickyWeek()) for (i in 0...songs.length) if (i > 2) {songs.pop(); songSprites.pop(); hitboxes.pop();}

        songSprites[0].color = 0xFFffffff;

        diffSprite = new FlxText(0, 0, FlxG.width, "EASY - 0", 10);
        diffSprite.setFormat(Paths.font('tahoma-bold.ttf'), 40, 0xFFff0000, "left");
        diffSprite.setPosition(box.x + 40, box.y + box.height - diffSprite.height - 40);

		for (i in [diffSprite, vignette, blackFade]) add(i);

        updateScoreText();

		if (hasBeatenTrickyWeek()){
			difficulties.push("erect");
			difficulties.push("nightmare");
		}

        FlxTween.tween(blackFade, {alpha: 0}, 0.2, { onComplete: _ -> {
            menuControllable = true;
        }});
	}

    function hasBeatenTrickyWeek() {
			// var level:String = "Clown";
			// if(debugTester) return true;
			// if (Save.instance.getLevelScore(level, 'hard')?.score == null || Save.instance.getLevelScore(level, 'hard')?.score == 0) return false;
					return true;
    }

	var diffSelected:Int = 1;
	var currentSong:Int = 0;

	function changeSong(target: Int) {
		if (target >= songs.length) target = 0;
		if (0 > target) target = songs.length-1;
		currentSong = target;

        for (i in songSprites){
			FlxTween.cancelTweensOf(i);
			if (songSprites.indexOf(i) == currentSong) {
				FlxTween.tween(i, {x: box.x + 130 - i.width*0.5}, 0.5, { ease: FlxEase.quartOut });
				i.color = 0xFFffffff;
			} else {
				FlxTween.tween(i, {x: box.x + 80 - i.width*0.5}, 0.5, { ease: FlxEase.quartOut });
				i.color = 0xFFff0000;
			}
        }

		if (currentSong == songs.indexOf("expurgation")) {difficulties = ["unfair", "nightmare"]; setDifficulty(0); return;}
		else if (currentSong == songs.indexOf("assault") || currentSong == songs.indexOf("tiky") || !hasBeatenTrickyWeek()) difficulties = ["hard"];
		else difficulties = ["easy", "normal", "hard", "erect", "nightmare"];
		setDifficulty(diffSelected);

        updateScoreText();
	}

	function setDifficulty(target: Int) {
		if (target >= difficulties.length) target = 0;
		if (0 > target) target = difficulties.length-1;
        diffSelected = target;
        updateScoreText();
	}

    function updateScoreText(){
        var diff:String;
        diff = difficulties[diffSelected].toUpperCase();
        if (diff == "NORMAL") diff = "MEDIUM";

        var score:String;
        if (Save.instance.getSongScore(songs[currentSong], difficulties[diffSelected])?.score == null) score = "N/A"
        else score = Save.instance.getSongScore(songs[currentSong], difficulties[diffSelected])?.score;

		if (diff == "ERECT" || diff == "NIGHTMARE") diffSprite.color = 0xFFffffff;
		else diffSprite.color = 0xFFff0000;
        diffSprite.text = "< " + diff + " - " + score + " >";
    }

	function startSong(songId:String, difficultyId:String, ?playNormalSound:Bool) {
		if(playNormalSound == null) playNormalSound = true;
        if (songId == "expurgation") {
            enterExpurgationWarningState(difficultyId);
            return;
        }

		FlxTransitionableState.skipNextTransIn = false;
		FlxTransitionableState.skipNextTransOut = false;

		PlayStatePlaylist.isStoryMode = false;
		PlayStatePlaylist.campaignId = null;

		var targetSongId:String = songId;
		var targetSongNullable:Null<Song> = SongRegistry.instance.fetchEntry(targetSongId);
		if (targetSongNullable == null) {
            FunkinSound.playOnce(Paths.sound('tricky/menu/burnSound'), 0.7);
		  	trace('WARN: could not find song with id (${targetSongId})');
		  	return;
		}
		var targetSong:Song = targetSongNullable;

		var targetVariation:String = Constants.DEFAULT_VARIATION;
        if (difficultyId == "erect" || difficultyId == "nightmare") targetVariation = "erect";
		var currentDifficulty:String = difficultyId;
		var targetInstId:String = null;

		var targetDifficulty:SongDifficulty = targetSong.getDifficulty(currentDifficulty, targetVariation); // returns "hard"
	    if (targetDifficulty == null) {
            FunkinSound.playOnce(Paths.sound('tricky/menu/burnSound'), 0.7);
			return;
		}

		if (targetInstId == null) {
			var baseInstrumentalId:String = targetSong.getBaseInstrumentalId(currentDifficulty, targetVariation);
			targetInstId = baseInstrumentalId;
		}

		FlxG.sound.music.stop();
        menuControllable = false;
		if(playNormalSound) FunkinSound.playOnce(Paths.sound("tricky/menu/confirm"));
		FlxTween.tween(blackFade, {alpha: 1}, 0.2, { onComplete: _ -> {
			LoadingState.loadPlayState({
				targetSong: targetSong,
				targetDifficulty: currentDifficulty,
				targetVariation: targetVariation,
				targetInstrumental: targetInstId,
				practiceMode: false,
				minimalMode: false,

				botPlayMode: false,
			}, true);
		}});
	}

	var tikyStep:String = "";

	override function update(elapsed:Float):Void {
		super.update(elapsed);
		if (!menuControllable) return;
		if (controls.BACK_P || FlxG.mouse.justPressedRight) exitTrickyState();
		if (controls.UI_LEFT_P || controls.UI_RIGHT_P) setDifficulty(diffSelected + (controls.UI_RIGHT_P ? 1 : -1));
		if (controls.UI_DOWN_P || controls.UI_UP_P) changeSong(currentSong + (controls.UI_DOWN_P ? 1 : -1));
		if (controls.ACCEPT_P){
			if(songs[currentSong] != 'tiky') startSong(songs[currentSong], difficulties[diffSelected], true);
			else {
				FunkinSound.playOnce(Paths.sound("tricky/menu/tiky"), 1, () -> {
					startSong("tiky", "hard", false);
				});
			}
		}
		if (TouchUtil.pressAction(hitboxes)) {
			for (i in hitboxes){
				if (TouchUtil.overlaps(i)) {
                    if (currentSong == hitboxes.indexOf(i)){
						if(songs[currentSong] != 'tiky') startSong(songs[currentSong], difficulties[diffSelected], true);
						else {
							FunkinSound.playOnce(Paths.sound("tricky/menu/tiky"), 1, () -> {
								startSong("tiky", "hard", false);
							});
						}
					} else changeSong(hitboxes.indexOf(i));
				}
			}
		}
		if (TouchUtil.pressAction(diffSprite)) setDifficulty(diffSelected + 1);
        if (FlxG.keys.justPressed.ANY) {
			if (FlxG.keys.justPressed.T) {
            	FunkinSound.playOnce(Paths.sound('tricky/menu/trickyType'), 1);
				tikyStep = "t";
			}
			else if (FlxG.keys.justPressed.I && tikyStep == "t") {
            	FunkinSound.playOnce(Paths.sound('tricky/menu/trickyType'), 1);
				tikyStep = "i";
			}
			else if (FlxG.keys.justPressed.K && tikyStep == "i") {
            	FunkinSound.playOnce(Paths.sound('tricky/menu/trickyType'), 1);
				tikyStep = "k";
			}
			else if (FlxG.keys.justPressed.Y && tikyStep == "k") {
				menuControllable = false;
                Save.instance.modOptions.set("tikyUnlocked", true);
				FunkinSound.playOnce(Paths.sound("tricky/menu/tiky"), 1, () -> {
					startSong("tiky", "hard");
				});
			}
			else tikyStep = "";
		}

		//shitty ass code, BUT IT WORKS SO STFU

		for(i in 0...songSprites.length) hitboxes[i].x = songSprites[i].x + (songSprites[i].width * 0.5);
	}

	function enterExpurgationWarningState(varString:String) {
		FunkinSound.playOnce(Paths.sound("tricky/menu/confirm"));
		openSubState(new ExpurgationWarningState(varString));
	}

	function exitTrickyState() {
        FlxTween.tween(blackFade, {alpha: 1}, 0.2, { onComplete: _ -> {
            bgCamera.visible = false;
            var state:MusicBeatState = new TrickyMenuState();
            FlxG.switchState(state);
        }});
	}
}
