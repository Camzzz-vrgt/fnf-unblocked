import Std;
import funkin.ui.options.OptionsState;
import funkin.modding.module.Module;
import funkin.save.Save;

class TrickyMenuToggle extends Module
{
  public function new()
  {
    super('TrickyMenuToggle', 1, {state: OptionsState});

    if (!Save.instance.modOptions.exists(TrickyMenuToggle.SAVE_KEY_TRICKYMENU)) Save.instance.modOptions.set(TrickyMenuToggle.SAVE_KEY_TRICKYMENU, true);
  }

  public static var SAVE_KEY_TRICKYMENU:String = "shouldUseTrickyMenus";

  override function onStateChangeEnd(event:StateChangeScriptEvent)
  {
    if (!Std.isOfType(event.targetState, OptionsState)) return;

    addTrickyMenuOption(event.targetState);
  }

  function addTrickyMenuOption(options:OptionsState)
  {
    var preferencesPage = options.optionsCodex.pages.get("preferences");
    if (preferencesPage != null)
    {
      preferencesPage.createPrefItemCheckbox("Tricky Menus", "Whether or not you want Tricky Menus to override the base game", function(value:Bool):Void
      {
        Save.instance.modOptions.set("shouldUseTrickyMenus", value);
        //trace('do i want the plush to show? $value');
        Save.instance.flush();
      }, toggleTrickyMenu());
    }
  }

  function toggleTrickyMenu():Bool
  {
    if (!Save.instance.modOptions.exists("shouldUseTrickyMenus")) return true;
    return Save.instance.modOptions.get("shouldUseTrickyMenus");
  }
}
