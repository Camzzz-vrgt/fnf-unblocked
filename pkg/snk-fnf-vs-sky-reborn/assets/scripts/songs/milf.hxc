import flixel.FlxG;
import flixel.util.FlxTimer;
import funkin.play.PlayState;
import funkin.play.song.Song;
import flixel.tweens.FlxEase;
import funkin.audio.FunkinSound;
import funkin.modding.base.ScriptedFunkinSprite;
import funkin.graphics.shaders.AdjustColorShader;
import funkin.graphics.FunkinSprite;


class MILFSkySong extends Song {
    
    var skyPuke;
    var hasPuked;
    var skyPukeSFX:FunkinSound;
    var limoShader:AdjustColorShader;

    function new() {
        super('milf');
    }

    function onCountdownStart(event) {
        super.onCountdownStart(event);
        if (PlayState.instance.currentVariation == 'sky') {
            hasPuked = false;
            

            limoShader = new AdjustColorShader();
            limoShader.hue = -30;
            limoShader.saturation = -20;
            limoShader.contrast = 0;
            limoShader.brightness = -30;

            loadAtlasCharacter();
        }
    }

    function onSongEnd(event) {
        super.onSongEnd(event);
        if (!hasPuked) {
            // change this number to 20 for a 20% chance  (hi genzu)
            if (FlxG.random.bool(20)) {
                hasPuked = true;
                event.cancel();
                doPuke();
            } else {
                ("No puke for you... you're lucky!!");
            }
        }
    }
    
    function doPuke() {
        trace("Awww Sky don't feel too good");
        var dad = PlayState.instance.currentStage.getDad();
        var boyfriend = PlayState.instance.currentStage.getBoyfriend();
        var boyfriendCam = [
            boyfriend.cameraFocusPoint.x,
            boyfriend.cameraFocusPoint.y
        ];
        
        var timer = new FlxTimer();

        var dadCam = [
            dad.cameraFocusPoint.x,
            dad.cameraFocusPoint.y
        ];
        
        boyfriend.alpha = 0;

        skyPuke.alpha = 1;
        skyPuke.scriptCall('playAnim');
        skyPukeSFX.play();

        PlayState.instance.tweenCameraZoom(1, 1, true, FlxEase.quadInOut);
        PlayState.instance.tweenCameraToPosition(boyfriendCam[0] + 50, boyfriendCam[1] + 80, 1, FlxEase.expoOut);

        new FlxTimer().start(1.3,  ()-> {
            PlayState.instance.tweenCameraZoom(1.15, 0.67, true, FlxEase.expoOut);
        });
        new FlxTimer().start(2.6,  ()-> {
            PlayState.instance.tweenCameraZoom(1.3, 0.67, true, FlxEase.expoOut);
        });

        new FlxTimer().start(4,  ()-> {
            PlayState.instance.tweenCameraToPosition(dadCam[0] -100, dadCam[1] - 70, 3.5, FlxEase.sineInOut);
            stoneSFX.play();
            PlayState.instance.currentStage.getDad().playAnimation("disappointment");
        });

        new FlxTimer().start(10, ()->{
            hasPuked = true;
            PlayState.instance.endSong(true);
        });


    }

    function loadAtlasCharacter() {
        var boyfriend = PlayState.instance.currentStage.getBoyfriend();

        skyPuke = ScriptedFunkinSprite.init("SkyPukeSprite", boyfriend.x - 230, boyfriend.y + 80);
        skyPuke.zIndex = boyfriend.zIndex;
        PlayState.instance.currentStage.add(skyPuke);
        skyPuke.alpha = 0;
        skyPuke.shader = limoShader;
        PlayState.instance.refresh();
        

        //also set up sound cos why not
        skyPukeSFX = FunkinSound.load(Paths.sound("skyPukin"), true, false);
        stoneSFX = FunkinSound.load(Paths.sound("stoneSlideSfx"), true, false);
    }

}