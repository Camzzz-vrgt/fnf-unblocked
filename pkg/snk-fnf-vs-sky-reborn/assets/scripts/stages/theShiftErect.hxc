import funkin.play.stage.Stage;
import funkin.play.PlayState;
import funkin.play.song.Song;
import funkin.util.MathUtil;
import flixel.FlxG;
import flixel.FlxSprite;
import funkin.graphics.shaders.AdjustColorShader;
import flixel.tweens.FlxEase;
import funkin.Conductor;
import flixel.tweens.FlxTween;
import flixel.util.FlxTimer;
import funkin.graphics.FunkinSprite;
import flixel.addons.display.FlxBackdrop;

class TheShiftErectStage extends Stage {

	var dih:Int = 0;
	var bgAngle:Int = 0;
	var shaderHue:Int = 0;

	var hudZoom;
	var colorShader:AdjustColorShader;
	var characterShader:AdjustColorShader;

	var candyStuff:Array<String> = ['taco'];
	var candyList:Array<FlxSprite> = []; 
	var candySpawnTimer:FlxTimer;
    var wePaused:Bool;
    var candyEnabled:Bool;
	var candyGradient:FunkinSprite;

	var heartsOverlay:FlxBackdrop;

	public function new() {
		super('theShiftErect');
	}

	function onCreate(event:ScriptEvent) {
		super.onCreate(event);
		hudZoom = PlayState.instance.defaultHUDCameraZoom;

        //candy stuff
        candyEnabled = false;
		candySpawnTimer = new FlxTimer();
		candySpawnTimer.start(0.2, function(_) {
			spawnCandy();
		}, 0);

		//make background shader earlier 4 less lag
		colorShader = new AdjustColorShader();
		colorShader.saturation = 15;
    	var backGround:FlxSprite = getNamedProp('pinkWorld');
    	backGround.shader = colorShader;

		if (PlayState.instance.currentVariation == 'pico')
			candyStuff = ['packofSkittles', 'popTart', 'lollipop', 'jollyRancher'];

		if (PlayState.instance.currentVariation == 'erect')
			candyStuff = ['taco'];

		heartsOverlay = new FlxBackdrop((Paths.image('shift/erect/seamlessHearts')), 0x11, 0, 0);
		heartsOverlay.velocity.set(125, 125);
		heartsOverlay.y = -500;
		heartsOverlay.alpha = 0.3;
		heartsOverlay.zIndex = 600;
		heartsOverlay.scale.set(1, 1);
		heartsOverlay.blend = 0;
		heartsOverlay.antialiasing = false;
		heartsOverlay.updateHitbox();
		add(heartsOverlay);
	}


	function spawnCandy() {
    if (!candyEnabled || wePaused) return;
	if (candyList.length >= 100) return;
	var candyVar = candyStuff[FlxG.random.int(0, candyStuff.length - 1)];
	var candy = new FlxSprite();
    var candySize:Int;

	if (PlayState.instance.currentVariation == 'pico')
	{
		candySize = FlxG.random.float(0.75, 1);
		candy.y = candy.height - 800;
	}
	else 
	{
		candySize = FlxG.random.float(1, 1.5);
		candy.y = candy.height - 600;
	}

	candy.loadGraphic(Paths.image('shift/candy/' + candyVar));
	candy.x = FlxG.random.float(0, FlxG.width * 2 - candy.width) - 500;
	candy.velocity.y = FlxG.random.float(400, 700);
	candy.acceleration.y = 50;
    
    candy.scale.x = candySize;
    candy.scale.y = candySize;

	candy.angularVelocity = FlxG.random.float(-300, 300);
	candy.angularDrag = 0;
	candy.angle = FlxG.random.float(0, 360);
	
    add(candy);
    candyList.push(candy);
	}

	function onUpdate(event) {
		super.onUpdate(event);

		dih += 0.75 + Math.sin((event.elapsed));
		shaderHue = Math.sin((Conductor.instance.songPosition / 450) * 1) * 30 - 15;
		characterShader.hue = shaderHue;
		colorShader.hue = dih;

		for (i in 0...candyList.length) {
    var candy = candyList[i];
    if (candy == null) continue; 

    if (candy.y > FlxG.height * 2) {
        remove(candy);
        candyList.splice(i, 1);
        i--;
        continue;
    }

    var candyFade = FlxG.height - 150;

    if (candy.y > candyFade) {
        var fadeness = (candy.y - candyFade) / 300;
        candy.alpha = 1 - fadeness;
        if (candy.alpha < 0) candy.alpha = 0;
        } else {
        candy.alpha = 1;
        }
        }
	}

	function onPause() {
		super.onPause();
		wePaused = true;
	}
    function onResume() {
		super.onResume();
		wePaused = false;
	}

    override function onBeatHit(event) {
		super.onBeatHit(event);
		
		switch (event.beat) {
				
			case 72:
				candyEnabled = true;
				spawnCandyGradient();
			case 136:
				candyEnabled = false;	
				destroyCandyGradient();	
		}
	
	} 
	
    function spawnCandyGradient() {
	

	var gradientName = switch (PlayState.instance.currentVariation) {
		case 'default': 'lollipopGradient';
		case 'erect': 'tacoGradient';
		case 'pico': 'lollipopGradient';
		default: null;
	};

	if (gradientName == null) return; 

	candyGradient = new FunkinSprite(0, 0).loadGraphic(Paths.image('shift/' + gradientName));
	candyGradient.cameras = [PlayState.instance.camHUD];
	candyGradient.blend = 0;
	candyGradient.alpha = 0;
	candyGradient.zIndex = 500;
	trace('added candy gradient!');
	PlayState.instance.add(candyGradient);
	if (candyGradient != null)
	{
		FlxTween.tween(candyGradient, {alpha: 0.5}, 1);
	}
	}

	function destroyCandyGradient(){
	if (candyGradient != null){
		FlxTween.tween(candyGradient, {alpha: 0}, 1).onComplete = function(twn:FlxTween) {
		remove(candyGradient);
			};
		}
	}

	override function addCharacter(character:BaseCharacter, charType:CharacterType):Void {
		// Apply the shader automatically to each character as it gets added.
		super.addCharacter(character, charType);
		trace('Applied stage shader to ' + character.characterName);

		characterShader = new AdjustColorShader();

		characterShader.saturation = 12;
		characterShader.contrast = 22;
		characterShader.brightness = -16;

		
	}

	function onSongStart(event:ScriptEvent) { 
			super.onSongStart(event);
			var currentOpponent = PlayState.instance.currentStage.getDad();


			for (animName in ['tomatoHit', 'danceRight-caramel', 'danceLeft-caramel', 'caramelTransition']) {
				currentOpponent.animation.play(animName, true);
				currentOpponent.draw();
			}
				trace('animation was preloaded!');
			if (PlayState.instance.comboPopUps != null && !FlxG.isMobile) PlayState.instance.comboPopUps.offsets =  [0, -120];


			PlayState.instance.currentStage.getDad().shader = characterShader;
			PlayState.instance.currentStage.getBoyfriend().shader = characterShader;
			PlayState.instance.currentStage.getGirlfriend().shader = characterShader;
			//shaders needa be added 2 each character otherwise itll geek out cos hue shifts
	}

	function onSongRetry()
	{
		//ideally, if u restart during the candy part shit goes back 2 normal
		candyEnabled = false;
		destroyCandyGradient();
	}

}
