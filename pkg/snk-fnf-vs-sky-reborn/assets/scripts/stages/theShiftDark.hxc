import funkin.play.stage.Stage;
import funkin.play.PlayState;
import funkin.util.MathUtil;
import flixel.FlxG;
import funkin.graphics.shaders.AdjustColorShader;
import flixel.tweens.FlxEase;
import funkin.Conductor;
import flixel.tweens.FlxTween;

class TheShiftDarkStage extends Stage {

    var dih:Int = 0;
    var hudZoom;
    var colorShader:AdjustColorShader;
    var cardboardShader:AdjustColorShader;
    var cardboardShaderFront:AdjustColorShader;
    var cardboardAssets = ["boyfriendCutout", "blurryCutout"];

	public function new() {
		super('theShiftDark');
	}

    function onCreate(event:ScriptEvent) {
        super.onCreate(event);

        var backGround:FlxSprite = getNamedProp('pinkWorld');
        var cardboardCutouts:FlxSprite = getNamedProp('boyfriendCutout');
        var cardboardCutoutsFront:FlxSprite = getNamedProp('blurryCutout');

        hudZoom = PlayState.instance.defaultHUDCameraZoom;

        colorShader = new AdjustColorShader();
        cardboardShader = new AdjustColorShader();
        cardboardShaderFront = new AdjustColorShader();
        colorShader.saturation = -46;
		colorShader.contrast = 5;
		colorShader.brightness = -80;
        backGround.shader = colorShader;


        cardboardCutouts.shader = cardboardShader;
        cardboardCutoutsFront.shader = cardboardShaderFront;
        adjustCardboardShaders();

    }

    function adjustCardboardShaders(){
        cardboardShader.brightness = -23;
        cardboardShader.saturation = -15;
		cardboardShader.contrast = -25;
        cardboardShader.hue = -6;

        cardboardShaderFront.brightness = -9;
        cardboardShaderFront.saturation = -8;
		cardboardShaderFront.contrast = -14;
        cardboardShaderFront.hue = -6;
    }

    function onUpdate(event) {
        super.onUpdate(event);

		dih += 0.25 + Math.sin((event.elapsed));
        colorShader.hue = dih;
        // trace("dih amount:" + dih);
    }
	public override function onSongEnd(event:CountdownScriptEvent) {
		super.onSongEnd(event);
	}
}
