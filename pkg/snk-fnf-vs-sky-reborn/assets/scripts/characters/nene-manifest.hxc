import funkin.play.character.AnimateAtlasCharacter;
import funkin.play.character.CharacterType;
import funkin.play.PlayState;
import funkin.audio.FunkinSound;
import funkin.play.song.Song;
import flixel.FlxG;
import flixel.FlxSprite;

class NeneManifestCharacter extends AnimateAtlasCharacter {
	
	function new() {
		super('nene-manifest');
	}

	var manifestRocket:FlxSprite;
	var refreshedRocket = false;

	function onCreate(event:ScriptEvent){
		super.onCreate(event);
		manifestRocket = new FlxSprite();
		manifestRocket.frames = Paths.getSparrowAtlas('shift/manifest/manifestRocket');
    	manifestRocket.x = this.x;
    	manifestRocket.y = this.y;
    	manifestRocket.zIndex = this.zIndex - 5;
		manifestRocket.animation.addByPrefix('idle', "baby rocket0", 24, true);
		manifestRocket.animation.addByPrefix('boost', "baby rocket boosting", 24, false);
		manifestRocket.animation.addByPrefix('fly', "baby rocket flying", 24, true);
		manifestRocket.animation.play('idle');
	}

	function onUpdate(event:UpdateScriptEvent)
  	{
    super.onUpdate(event);

    // Set the visibility of ABot to match Nene's.
    manifestRocket.visible = this.visible;
	manifestRocket.y = this.y + 154; // 764 - 740
	if (!refreshedRocket)
    {
      manifestRocket.x = this.x + 24;
      manifestRocket.y = this.y + 154; // 764 - 740
      manifestRocket.zIndex = this.zIndex - 10;
      PlayState.instance.currentStage.add(manifestRocket);
	  PlayState.instance.currentStage.refresh();
      refreshedRocket = true;
    	}
    }
	override function playAnimation(name:String, restart:Bool, ignoreOther:Bool) {
		super.playAnimation(name, restart, ignoreOther);
	if(name == 'guh') 
		manifestRocket.animation.play('boost');

	if(name == 'neneScramble') 
		manifestRocket.animation.play('fly');
	}
}
