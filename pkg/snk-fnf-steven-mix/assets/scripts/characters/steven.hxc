import funkin.play.character.MultiAnimateAtlasCharacter;
import funkin.play.PlayState;
import funkin.play.GameOverSubState;
import funkin.play.PauseSubState;
import flixel.FlxSprite;
import funkin.graphics.FunkinSprite;
import flixel.FlxG;

class StevenCharacter extends MultiAnimateAtlasCharacter {
	function new() {
		super('steven');
	}

	function onCreate(event:ScriptEvent) {
		super.onCreate(event);

		GameOverSubState.musicSuffix = '-steven';
		GameOverSubState.blueBallSuffix = '-steven';

		PauseSubState.musicSuffix = '';
	}

	function playAnimation(name:String, restart:Bool = false, ignoreOther:Bool = false, reversed:Bool = false) {

		super.playAnimation(name, restart, ignoreOther, reversed);

		if (name == "firstDeath") {
			this.shader = null;
		}
	}
}
