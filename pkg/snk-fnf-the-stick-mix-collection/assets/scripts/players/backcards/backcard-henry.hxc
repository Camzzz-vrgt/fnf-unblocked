import funkin.ui.freeplay.backcards.BackingCard;
import flixel.math.FlxMath;
import flixel.FlxSprite;
import funkin.ui.freeplay.FreeplayState;
import funkin.util.BitmapUtil;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import flixel.util.FlxTimer;
import funkin.graphics.adobeanimate.FlxAtlasSprite;
import flixel.addons.display.FlxBackdrop;
import funkin.ui.FullScreenScaleMode;
import funkin.Conductor;

class HenryCard extends BackingCard
{
  var bgSky:FlxSprite;
  var bgMult:FlxSprite;
  var bgWhite:FlxSprite;
  var scrollLower:FlxBackdrop;
  var scrollTop:FlxBackdrop;
  var scrollMiddle:FlxBackdrop;
  var tumbleWeed:FlxBackdrop;

  var confirmAtlas:FlxAtlasSprite;

  public function new()
  {
    super("henry");
  }

  public override function enterCharSel():Void
  {
    FlxTween.tween(scrollLower.velocity, {x: 0}, 0.8, {ease: FlxEase.sineIn});
    FlxTween.tween(scrollTop.velocity, {x: 0}, 0.8, {ease: FlxEase.sineIn});
    FlxTween.tween(scrollMiddle.velocity, {x: 0}, 0.8, {ease: FlxEase.sineIn});
  }

  public override function applyExitMovers(?exitMovers:FreeplayState.ExitMoverData, ?exitMoversCharSel:FreeplayState.ExitMoverData):Void
  {
    super.applyExitMovers(exitMovers, exitMoversCharSel);
    if (exitMovers == null || exitMoversCharSel == null) return;

    exitMoversCharSel.set([scrollTop],
      {
        y: -90,
        speed: 0.8,
        wait: 0.1
      });

    exitMoversCharSel.set([scrollMiddle],
      {
        y: -80,
        speed: 0.8,
        wait: 0.1
      });

    exitMoversCharSel.set([scrollLower],
      {
        y: -60,
        speed: 0.8,
        wait: 0.1
      });

  }

  public override function onCreate(event:ScriptEvent):Void
  {
    bgSky = new FlxSprite(0, 0).loadGraphic(Paths.image('freeplay/backingCards/henry/bgSky'));
    add(bgSky);

    bgMult = new FlxSprite(0, 0).loadGraphic(Paths.image('freeplay/backingCards/henry/multiply'));
    bgMult.blend = 9;
    

    confirmTextGlow.visible = false;
    confirmGlow.visible = false;
    confirmGlow2.visible = false;

    scrollTop = new FlxBackdrop(Paths.image('freeplay/backingCards/henry/topLoop'), 0x01, 160);
    scrollTop.setPosition(0, 200);
    scrollTop.velocity.x = -25;
    add(scrollTop);

    scrollMiddle = new FlxBackdrop(Paths.image('freeplay/backingCards/henry/middleLoop'), 0x01, 150);
    scrollMiddle.setPosition(0, 85);
    add(scrollMiddle);
    scrollMiddle.velocity.x = -50;

    scrollLower = new FlxBackdrop(Paths.image('freeplay/backingCards/henry/lowerLoop'), 0x01, 80);
    scrollLower.setPosition(0, 300);
    scrollLower.velocity.x = -150;
    add(scrollLower);

    tumbleWeed = new FlxBackdrop(Paths.image('freeplay/backingCards/henry/tumbleweed'), 0x01, 5000);
    tumbleWeed.setPosition(0, 300);
    tumbleWeed.velocity.x = -340;
    add(tumbleWeed);
    FlxTween.tween(tumbleWeed, {y: tumbleWeed.y - 10}, 0.2, {ease: FlxEase.sineOut, type: 4});

    add(bgMult);

    bgWhite = new FlxSprite(0, 0).makeGraphic(1280, 720, 0xFFFFFFFF);
    add(bgWhite);

    scrollLower.visible = true;
    scrollTop.visible = true;
    scrollMiddle.visible = true;
    bgSky.visible = true;
    bgMult.visible = false;
    bgWhite.visible = false;

  }

