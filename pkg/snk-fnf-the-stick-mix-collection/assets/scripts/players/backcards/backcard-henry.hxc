    FlxTween.tween(scrollLower.velocity, {x: 0}, 0.6, {ease: FlxEase.circIn});
    FlxTween.tween(scrollMiddle.velocity, {x: 0}, 0.6, {ease: FlxEase.circIn});
    FlxTween.tween(scrollTop.velocity, {x: 0}, 0.6, {ease: FlxEase.circIn});
    FlxTween.tween(tumbleWeed.velocity, {x: 0}, 0.6, {ease: FlxEase.circIn});

