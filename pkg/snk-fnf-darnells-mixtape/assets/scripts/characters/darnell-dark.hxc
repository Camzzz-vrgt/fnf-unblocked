import funkin.graphics.adobeanimate.FlxAtlasSprite;
import flixel.FlxG;
import funkin.audio.FunkinSound;
import funkin.play.character.SparrowCharacter;
import funkin.play.GameOverSubState;
import funkin.play.character.BaseCharacter;
import funkin.data.character.CharacterDataParser;
import funkin.play.character.CharacterType;
import funkin.play.PlayState;
import funkin.play.character.MultiSparrowCharacter;
import funkin.util.HapticUtil;
import funkin.play.PlayState;
import funkin.play.PauseSubState;
import funkin.play.GameOverSubState;

class DarnellDarkCharacter extends MultiSparrowCharacter
{
  function new()
  {
    super('darnell-dark');
  }

  var normalChar:BaseCharacter;

  override function set_alpha(val:Float):Float
  {
    super.set_alpha(val);
    if (val != 1) normalChar.alpha = 1;
    else
      normalChar.alpha = 0;

    return val;
  }

  override function playAnimation(name:String, restart:Bool, ignoreOther:Bool)
  {
    super.playAnimation(name, restart, ignoreOther);
    if (normalChar != null)
    {
      normalChar.playAnimation(name, restart, ignoreOther);
      normalChar.setPosition(this.x - 157, this.y - 25);
    }
  }

	override function onSongRetry(event:ScriptEvent):Void {
		super.onSongRetry(event);

		// Don't let these pile up.

		// Reset to standard death animation.
		GameOverSubState.musicSuffix = '-darnell';
		GameOverSubState.blueBallSuffix = '-darnell';

		PauseSubState.musicSuffix = '-darnell';

		this.visible = true;
	}

  function onCreate(event:ScriptEvent)
  {
    super.onCreate(event);
    normalChar = CharacterDataParser.fetchCharacter('darnell-player');
    normalChar.zIndex = 199;
    normalChar.alpha = 0.0001;
    normalChar.flipX = true;

    PlayState.instance.currentStage.add(normalChar);
    PlayState.instance.currentStage.refresh(); // Apply z-index.

    GameOverSubState.musicSuffix = '-darnell';
    GameOverSubState.blueBallSuffix = '-darnell';

    PauseSubState.musicSuffix = '-darnell';
  }
}
