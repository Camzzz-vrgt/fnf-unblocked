    var stageSprite:Array<FlxSprite> = [];
    var stagebg:Array<FlxSprite> = [];


    function clearStageImage():Void
    {
        if (stageSprite != null && stageSprite.length > 0)
        {
            for (sprite in stageSprite)
            {
                game.currentStage.remove(sprite);
                sprite.destroy();
            }
            stageSprite = [];
        }

        if (stagebg != null && stagebg.length > 0)
        {
            for (bg in stagebg)
            {
                game.currentStage.remove(bg);
                bg.destroy();
            }
            stagebg = [];
        }
    }

	override function onSongRetry(event:ScriptEvent)
    {
        if (PlayState.instance == null) return;

soundwaveOn = false;
swBts = null;
swKhz = 0;
swCh = 0;
for (b in bars)
{
    if (b != null)
    {
        FlxTween.cancelTweensOf(b);
        b.visible = false;
        b.alpha = 1;
        b.y = 1720;
        b.scale.y = 0.001;
    }
}

    if (game != null && game.camHUD != null)
    {
        game.camHUD.visible = true;
        game.camHUD.alpha = 1;
    }
        clearHUDSprites();
        clearStageImage();

        if (invertShader != null) invertShader.setIntensity(0.0);
        if (fisheyeShader != null) fisheyeShader.setFloat("strength", 0.0);
        fisheyeStrength = 0.0;
        if (game != null && game.camGame.filters != null)
        {
            var removeIndex = game.camGame.filters.indexOf(invertFilter);
            if (removeIndex != -1) game.camGame.filters.splice(removeIndex, 1);
            removeIndex = game.camGame.filters.indexOf(fisheyeFilter);
            if (removeIndex != -1) game.camGame.filters.splice(removeIndex, 1);
            removeIndex = game.camGame.filters.indexOf(fishFilter);
            if (removeIndex != -1) game.camGame.filters.splice(removeIndex, 1);
        }

        // onSongRetry already performs PlayState's in-place reset. Creating a
        // second PlayState bypasses HTML5's async loading path and can leave
        // the next state without its instrumental or vocals.
    }
}
