        game.insert(1, whiteBoxRightText);

blackScreen = new FlxSprite();
blackScreen.makeGraphic(FlxG.width, FlxG.height, 0xFF000000);
blackScreen.alpha = 1;
blackScreen.scrollFactor.set();
blackScreen.cameras = [game.camHUD];
blackScreen.zIndex = 100;
