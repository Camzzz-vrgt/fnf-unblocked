    }

        function addFilter(filter:ShaderFilter):Void
    {
        if (!Preferences.shaders) return;
        if (game.camGame.filters == null)
            game.camGame.filters = [filter];
        else
            game.camGame.filters.push(filter);
    }
    function showWhiteBoxRight(text:String):Void
    {
        whiteBoxRight.alpha = 1;
        whiteBoxRight.scale.x = 0;
        whiteBoxRight.scale.y = FlxG.height;
        whiteBoxRight.x = FlxG.width * 0.65;
        whiteBoxRight.y = (FlxG.height / 2);
        whiteBoxRight.origin.x = 1.0;
        whiteBoxRight.origin.y = 0.5;

        whiteBoxRightText.text = text;
        whiteBoxRightText.alpha = 1;
        whiteBoxRightText.x = FlxG.width / 2 - 30;
        whiteBoxRightText.y = FlxG.height / 2 - 60;

        FlxTween.cancelTweensOf(whiteBoxRight.scale, ["x"]);
        FlxTween.cancelTweensOf(whiteBoxRight, ["x"]);

        FlxTween.tween(whiteBoxRight.scale, {x: 1}, 0.15, {ease: FlxEase.sineInOut});
        FlxTween.tween(whiteBoxRight, {x: FlxG.width * 0.6}, 0.15, {ease: FlxEase.sineInOut});
    }

    function hideWhiteBoxRight():Void
    {
        FlxTween.cancelTweensOf(whiteBoxRight.scale, ["x"]);
        FlxTween.cancelTweensOf(whiteBoxRight, ["x"]);

        FlxTween.tween(whiteBoxRight.scale, {x: 0}, 0.1, {ease: FlxEase.sineInOut});
        FlxTween.tween(whiteBoxRight, {x: FlxG.width * 0.65}, 0.1, {
            ease: FlxEase.sineInOut,
            onComplete: function(_) {
                whiteBoxRight.alpha = 0;
                whiteBoxRightText.alpha = 0;
            }
        });
    }

    function showWhiteBox(text:String):Void
    {
        whiteBox.alpha = 1;
        whiteBox.scale.y = 0;
        whiteBox.y = (FlxG.height / 2);
        whiteBox.origin.y = 0.5;

        whiteBoxText.text = text;
        whiteBoxText.alpha = 1;
        whiteBoxText.scale.set(1.0, 1.0);
        whiteBoxText.x = (FlxG.width / 2) - (whiteBoxText.width / 2);

        FlxTween.cancelTweensOf(whiteBox.scale, ["y"]);
        FlxTween.tween(whiteBox.scale, {y: 150}, 0.1, {ease: FlxEase.sineInOut});
    }

    function showWhiteBoxLeft(text:String):Void
    {
        whiteBoxLeft.alpha = 1;
        whiteBoxLeft.scale.x = 0;
        whiteBoxLeft.scale.y = FlxG.height;
        whiteBoxLeft.x = FlxG.width * 0.15;
        whiteBoxLeft.y = (FlxG.height / 2);
        whiteBoxLeft.origin.x = 0;
        whiteBoxLeft.origin.y = 0.5;

        whiteBoxLeftText.text = text;
        whiteBoxLeftText.alpha = 1;
        whiteBoxLeftText.x = FlxG.width / 2 - 700;
        whiteBoxLeftText.y = FlxG.height / 2 - 60;

        FlxTween.cancelTweensOf(whiteBoxLeft.scale, ["x"]);
        FlxTween.cancelTweensOf(whiteBoxLeft, ["x"]);

        FlxTween.tween(whiteBoxLeft.scale, {x: 1}, 0.15, {ease: FlxEase.sineInOut});
        FlxTween.tween(whiteBoxLeft, {x: FlxG.width * 0.08}, 0.15, {ease: FlxEase.sineInOut});
    }

    function hideWhiteBoxLeft():Void
    {
        FlxTween.cancelTweensOf(whiteBoxLeft.scale, ["x"]);
        FlxTween.cancelTweensOf(whiteBoxLeft, ["x"]);

        FlxTween.tween(whiteBoxLeft.scale, {x: 0}, 0.1, {ease: FlxEase.sineInOut});
        FlxTween.tween(whiteBoxLeft, {x: FlxG.width * 0.15}, 0.1, {
            ease: FlxEase.sineInOut,
            onComplete: function(_) {
                whiteBoxLeft.alpha = 0;
                whiteBoxLeftText.alpha = 0;
            }
        });
    }

	function spawnHUDImage(imagePath:String, x:Float, y:Float, ?isCentered:Bool = false, ?targetScale:Float = 1.0):Void
	{
		var sprite = new FlxSprite();
		sprite.loadGraphic(Paths.image(imagePath));

		if (isCentered)
		{
			sprite.screenCenter();
			sprite.x += x;
			sprite.y += y;
		}
		else
		{
			sprite.x = x;
			sprite.y = y;
		}

		var startScale:Float = isCentered ? 1.8 : 1.5;
		sprite.scale.set(startScale, startScale);
		sprite.updateHitbox();

		sprite.scrollFactor.set();
		sprite.cameras = [game.camHUD];
		sprite.blend = 1;

		game.insert(1, sprite);
		hudSprites.push(sprite);

		FlxTween.tween(sprite.scale, {x: targetScale, y: targetScale}, 0.2, {ease: FlxEase.quadOut});
	}

	function clearHUDSprites():Void
	{
		for (sprite in hudSprites)
		{
			game.remove(sprite);
			sprite.destroy();
		}
		hudSprites = [];
	}


    function headachePulse(intensity:Float, duration:Float):Void
{
    pulseShader.setIntensity(intensity);
    game.camGame.filtersEnabled = true;

    new FlxTimer().start(duration, function(_) {
        pulseShader.setIntensity(0.0);
    });
}

function buildBars():Void
{
    var baseX:Float = -400;
    var baseY:Float = 920;
    bars = [];
    barHeights = [];

    for (i in 0...NUM_BARS)
    {
        var bx:Float = baseX + i * 90;
        var bar = new FlxSprite(bx, baseY);
        try { bar.loadGraphic(Paths.image('circle')); } catch (e:Dynamic) {
            bar.makeGraphic(20, 200, 0xFFFFFFFF);
        }
        bar.scale.x = 0.8;
        bar.scale.y = 0.001;
        bar.angle = 180;
        bar.origin.y = 1;
        bar.scrollFactor.set(0.4, 0.4);
        bar.zIndex = 3;
        bar.visible = false;
        game.currentStage.add(bar);
        bars.push(bar);
        barHeights.push(0);
    }
    game.currentStage.refresh();
}

	override function addCharacter(character:BaseCharacter, charType:CharacterType):Void
	{
		super.addCharacter(character, charType);
	}

        override function onUpdate(event:UpdateScriptEvent):Void
    {
        super.onUpdate(event);

        if (bloom != null)
    {
        bloom.setFloat("effect", effect);
        bloom.setFloat("strength", strength);
    }

        if (soundwaveOn && bars.length > 0)
{
    var swSm:Float = 1 - Math.pow(0.9, event.elapsed * 60);
    try {
        var snd = FlxG.sound.music;
        if (swBts == null && snd != null && snd._sound != null && snd._sound.__buffer != null && snd._sound.__buffer.data != null) {
            var buf0 = snd._sound.__buffer;
            swKhz = buf0.sampleRate / 1000;
            swCh = buf0.channels;
            swBts = buf0.data.buffer;
        }
        if (swBts != null && snd != null) {
            var khz:Float = swKhz;
            var channels:Int = swCh;
            var bts = swBts;
            var index:Int = Std.int(snd.time * khz);
            var i2:Int = 0;
            while (i2 < bars.length) {
                var sampleIndex:Int = index + ((i2 + 1) * 100);
                var pos:Int = sampleIndex * channels * 2;
                var byte:Float = 0;
                if (pos >= 0 && pos < bts.length - 2) byte = bts.getUInt16(pos);
                if (byte > 32767) byte = byte - 65535;
                if (byte < 0) byte = -byte;
                var targetHeight:Float = byte / 32767 * 8.0;
                if (targetHeight < 0) targetHeight = 0;
                barHeights[i2] += (targetHeight - barHeights[i2]) * swSm;
                var finalScale:Float = barHeights[i2];
                if (finalScale < 0.01) finalScale = 0.01;
                bars[i2].scale.y = finalScale;
                i2++;
            }
        }
    } catch (e:Dynamic) {}
}

        if (fisheyeShader != null)
        {
            fisheyeShader.setFloat("strength", fisheyeStrength);
        }

        if (camFrozen)
        {
            game.camGame.scroll.set(freezeX, freezeY);
        }
    }

    function doBloom(duration:Float, intensity:Float):Void
{
    if (!Preferences.shaders) return;
    effect = intensity;
    strength = intensity;

    if (game.camGame.filters == null)
        game.camGame.filters = [];

    if (game.camGame.filters.indexOf(bloomFilter) == -1)
        game.camGame.filters.push(bloomFilter);

    FlxTween.cancelTweensOf(effect);
    FlxTween.num(effect, 0, duration, {
        onUpdate: function(t) {
            effect = t.value;
            if (bloom != null) bloom.setFloat("effect", effect);
        }
    });

    FlxTween.cancelTweensOf(strength);
    FlxTween.num(strength, 0, duration, {
        onUpdate: function(t) {
            strength = t.value;
            if (bloom != null) bloom.setFloat("strength", strength);
        },
        onComplete: function(_) {
            if (game.camGame.filters != null)
            {
                var removeIndex = game.camGame.filters.indexOf(bloomFilter);
                if (removeIndex != -1) game.camGame.filters.splice(removeIndex, 1);
            }
        }
    });
}

    override function onStepHit(event:SongTimeScriptEvent)
    {
        super.onStepHit(event);
        var currentStep:Int = event.step;

       if (event.step == 0 && blackScreen != null)
        {
            blackScreen.alpha = 0;
        }

        if (pulseShader != null)
    pulseShader.setTime(Conductor.instance.songPosition / 1000);

        if (currentStep >= 160 && currentStep <= 288 && currentStep % 4 == 0)
        {
            FlxTween.cancelTweensOf(game.camGame, ["y"]);
            FlxTween.tween(game.camGame, {y: 10}, 0.2, {
                ease: FlxEase.sineOut,
                onComplete: function(_) {
                    FlxTween.tween(game.camGame, {y: 0}, 0.2, {ease: FlxEase.sineIn});
                }
            });
        }

        if (currentStep >= 752 && currentStep <= 800 && currentStep % 4 == 0)
        {
            FlxTween.cancelTweensOf(game.camGame, ["y"]);
            FlxTween.tween(game.camGame, {y: 10}, 0.2, {
                ease: FlxEase.sineOut,
                onComplete: function(_) {
                    FlxTween.tween(game.camGame, {y: 0}, 0.2, {ease: FlxEase.sineIn});
                }
            });
        }
        if (currentStep >= 1264 && currentStep <= 1484 && currentStep % 4 == 0)
        {
            FlxTween.cancelTweensOf(game.camGame, ["y"]);
            FlxTween.tween(game.camGame, {y: 10}, 0.2, {
                ease: FlxEase.sineOut,
                onComplete: function(_) {
                    FlxTween.tween(game.camGame, {y: 0}, 0.2, {ease: FlxEase.sineIn});
                }
            });
        }

        if (whiteBoxText.alpha == 1 && currentStep % 4 == 0 && currentStep >= 180 && currentStep <= 288)
        {
            var currentScale:Float = whiteBoxText.scale.x;
            whiteBoxText.scale.set(currentScale + 0.3, currentScale + 0.3);
            whiteBoxText.x = (FlxG.width / 2) - (whiteBoxText.width / 2);
        }

        if (whiteBoxText.alpha == 1 && currentStep % 4 == 0 && currentStep >= 772 && currentStep <= 784)
        {
            var currentScale:Float = whiteBoxText.scale.x;
