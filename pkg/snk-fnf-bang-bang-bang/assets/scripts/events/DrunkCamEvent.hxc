import funkin.play.event.SongEvent;
import funkin.play.PlayState;
import funkin.modding.module.Module;
import funkin.modding.module.ModuleHandler;
import flixel.math.FlxMath;

class DrunkCamModule extends Module {
    public var on:Bool = false;
    public var xRange:Float = 50;
    public var yRange:Float = 30;
    public var aRange:Float = 5;
    public var speed:Float = 0.5;

    var noiseX:Float = 0;
    var noiseY:Float = 0;
    var noiseZ:Float = 0;
    var p:Array<Int>;
    var permutation:Array<Int> = [151,160,137,91,90,15,131,13,201,95,96,53,194,233,7,225,140,36,103,30,69,142,8,99,37,240,21,10,23,190,6,148,247,120,234,75,0,26,197,62,94,252,219,203,117,35,11,32,57,177,33,88,237,149,56,87,174,20,125,136,171,168,68,175,74,165,71,134,139,48,27,166,77,146,158,231,83,111,229,122,60,211,133,230,220,105,92,41,55,46,245,40,244,102,143,54,65,25,63,161,1,216,80,73,209,76,132,187,208,89,18,169,200,196,135,130,116,188,159,86,164,100,109,198,173,186,3,64,52,217,226,250,124,123,5,202,38,147,118,126,255,82,85,212,207,206,59,227,47,16,58,17,182,189,28,42,223,183,170,213,119,248,152,2,44,154,163,70,221,153,101,155,167,43,172,9,129,22,39,253,19,98,108,110,79,113,224,232,178,185,112,104,218,246,97,228,251,34,242,193,238,210,144,12,191,179,162,241,81,51,145,235,249,14,239,107,49,192,214,31,181,199,106,157,184,84,204,176,115,121,50,45,127,4,150,254,138,236,205,93,222,114,67,29,24,72,243,141,128,195,78,66,215,61,156,180];

    function reset() {
        on = false;
        noiseX = noiseY = noiseZ = 0;
        if (p == null) p = permutation.concat(permutation);
    }
    
    override function onUpdate(e:UpdateScriptEvent) {
        if (PlayState.instance == null) return;
        var cam = PlayState.instance.camGame;
        var hud = PlayState.instance.camHUD;

        if (!on) {
            if (Math.abs(cam.x) < 0.1 && Math.abs(cam.y) < 0.1 && Math.abs(cam.angle) < 0.1) return;
        }

        var targetX:Float = 0;
        var targetY:Float = 0;
        var targetAngle:Float = 0;

        if (on) {
            noiseX += e.elapsed * speed * 0.42;
            noiseY += e.elapsed * speed * 0.42;
            noiseZ += e.elapsed * speed * 0.42;
            targetX = getNoise(noiseX, 0, 0) * xRange;
            targetY = getNoise(0, noiseY, 0) * yRange;
            targetAngle = getNoise(0, 0, noiseZ) * aRange;
        }

        var lerpFactor:Float = FlxMath.bound(speed / 210, 0.028, 0.095);
        cam.x = FlxMath.lerp(cam.x, targetX, lerpFactor);
        cam.y = FlxMath.lerp(cam.y, targetY, lerpFactor);
        cam.angle = FlxMath.lerp(cam.angle, targetAngle, lerpFactor);
        hud.x = FlxMath.lerp(hud.x, targetX * 0.7, lerpFactor);
        hud.y = FlxMath.lerp(hud.y, targetY * 0.7, lerpFactor);
        hud.angle = FlxMath.lerp(hud.angle, targetAngle * 0.7, lerpFactor);
    }

    private function getNoise(x:Float, y:Float, z:Float):Float {
        var X:Int = Std.int(Math.floor(x % 255));
        var Y:Int = Std.int(Math.floor(y % 255));
        var Z:Int = Std.int(Math.floor(z % 255));
        x = x - Math.floor(x);
        y = y - Math.floor(y);
        z = z - Math.floor(z);
        var u:Float = fade(x);
        var v:Float = fade(y);
        var w:Float = fade(z);
        var A:Int = p[X] + Y;
        var AA:Int = p[A] + Z;
        var AB:Int = p[A + 1] + Z;
        var B:Int = p[X + 1] + Y;
        var BA:Int = p[B] + Z;
        var BB:Int = p[B + 1] + Z;
        return lerp(w,
            lerp(v, lerp(u, grad(p[AA], x, y, z), grad(p[BA], x - 1, y, z)),
            lerp(u, grad(p[AB], x, y - 1, z), grad(p[BB], x - 1, y - 1, z))),
            lerp(v, lerp(u, grad(p[AA + 1], x, y, z - 1), grad(p[BA + 1], x - 1, y, z - 1)),
            lerp(u, grad(p[AB + 1], x, y - 1, z - 1), grad(p[BB + 1], x - 1, y - 1, z - 1))));
    }

    private function fade(t:Float):Float { return t * t * t * (t * (t * 6 - 15) + 10); }
    private function lerp(t:Float, a:Float, b:Float):Float { return a + t * (b - a); }
    private function grad(hash:Int, x:Float, y:Float, z:Float):Float {
        var h:Int = hash % 16;
        var u:Float = (h < 8) ? x : y;
        var v:Float = (h < 4) ? y : (h == 12 || h == 14) ? x : z;
        return ((h % 2 == 0) ? u : -u) + ((h % 4 == 0) ? v : -v);
    }

    function onSongRetry(e) { reset(); }
    function onDestroy(e) { reset(); }
    function onSongEnd(e) { reset(); }
    function onSongStart(e) { reset(); }
}

class DrunkCamEvent extends SongEvent
{
    public function new()
    {
        super("DrunkCamEvent");
    }

    public var eventTitle:String = "DrunkCamEvent";

    override public function handleEvent(data:Dynamic):Void
    {
        if (PlayState.instance == null) return;

        var md = ModuleHandler.getModule('DrunkCamModule');
        if (md == null) return;

        md.on      = data?.getBool("enabled") ?? true;
        md.xRange  = data?.getFloat("x") ?? 50;
        md.yRange  = data?.getFloat("y") ?? 30;
        md.aRange  = data?.getFloat("angle") ?? 5;
        md.speed   = data?.getFloat("speed") ?? 0.5;
    }

    override public function getTitle():String
    {
        return eventTitle;
    }

    override public function getEventSchema()
    {
        return [
            {
                name: "enabled",
                title: "Enabled",
                type: "bool",
                defaultValue: true
            },
            {
                name: "x",
                title: "X Range",
                type: "float",
                defaultValue: 50,
                min: 0,
                max: 200,
                step: 5
            },
            {
                name: "y",
                title: "Y Range",
                type: "float",
                defaultValue: 30,
                min: 0,
                max: 200,
                step: 5
            },
            {
                name: "angle",
                title: "Angle Range",
                type: "float",
                defaultValue: 5,
                min: 0,
                max: 20,
                step: 0.5
            },
            {
                name: "speed",
                title: "Speed",
                type: "float",
                defaultValue: 0.5,
                min: 0,
                max: 6,
                step: 0.1
            }
        ];
    }
}