class NeneCapsuleFix extends Module
{  
	public function new()
	{
		super('NeneCapsuleFix');
	}

	var coolAlpha:Float = 0.8;
	override function onUpdate(event)
	{
		if (FlxG.state.subState != null && Std.isOfType(FlxG.state.subState, FreeplayState) && FlxG.state.subState.currentCharacterId == "neneplayer")
		{
			for (cap in FlxG.state.subState.grpCapsules.members)
			{
				for (num in cap.bpmNumbers) num.alpha = coolAlpha;
				for (num in cap.difficultyNumbers) num.alpha = coolAlpha;
				//for (num in cap.weekNumbers) num.alpha = coolAlpha;
	
				cap.bpmText.alpha = coolAlpha;
				//cap.weekType.alpha = coolAlpha;
				cap.difficultyText.alpha = coolAlpha;
			}
		}
	}

}
