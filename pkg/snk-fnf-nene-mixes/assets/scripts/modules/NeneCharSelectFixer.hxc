class NeneCharSelectFixer extends Module
{

	public function new()
    {
		super('NeneCharSelectFixer', 0, { state: CharSelectSubState });
	}

	function onUpdate(event:UpdateScriptEvent)
	{
		super.onUpdate(event);

		var gfChill = FlxG.state.gfChill;
		if (gfChill != null)
		{
			// trace(gfChill.currentGFPath);
			if (gfChill.currentGFPath == "charSelect/dipshitCass")
			{
				if (gfChill.anim.name == "idle")
				{
					gfChill.anim.play("idle-loop", true);
					gfChill.anim.curAnim.looped = true;
				}
			}
		}
	}
}
