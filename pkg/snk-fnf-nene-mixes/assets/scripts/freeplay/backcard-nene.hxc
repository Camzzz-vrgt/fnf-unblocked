  public override function introDone():Void
  {
	coolBg.alpha = 0;
	FlxTween.tween(coolBg, {alpha: 1}, 0.15, {ease: FlxEase.sineOut});
	FlxTween.tween(grad, {alpha: 1}, 0.15, {ease: FlxEase.sineOut});

	FlxTween.tween(sketchesBack, {alpha: .4}, 0.15, {ease: FlxEase.sineOut});
	FlxTween.tween(sketchesFront, {alpha: 1}, 0.15, {ease: FlxEase.sineOut});

	FlxTween.tween(seal, {alpha: 1}, 0.15, {ease: FlxEase.sineOut});
	coolBg.visible = true;
		
	sealTimer = FlxG.random.float(3, 6);
  }

  public override function disappear():Void
  {
	FlxTween.tween(coolBg, {alpha: 0}, 0.25, {ease: FlxEase.sineOut});
	FlxTween.tween(grad, {alpha: 0}, 0.25, {ease: FlxEase.sineOut});
	FlxTween.tween(seal, {y: 900, alpha: 0}, 0.25, {ease: FlxEase.sineOut});
	FlxTween.tween(sketchesBack, {x: -100, alpha: 0}, 0.25, {ease: FlxEase.sineOut});
	FlxTween.tween(sketchesFront, {x: -100, alpha: 0}, 0.25, {ease: FlxEase.sineOut});
  }

  override public function update(elapsed:Float):Void
  {
    super.update(elapsed);

	if (sealTimer > 0)
	{
		sealTimer -= elapsed;
		if (sealTimer <= 0)
		{
			seal.flipX = !seal.flipX;
			seal.visible = true;
			seal.animation.play("y", true);
			sealTimer = -1;
		}
	}
    /*var scrollProgress:Float = Math.abs(scrollTop.x % (scrollTop.frameWidth + 20));

