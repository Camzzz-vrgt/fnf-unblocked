	var coolBg;
	var grad;

	var sketchesBack:FlxBackdrop;
	var sketchesFront:FlxBackdrop;
	
	var seal;
	var sealTimer:Float = -1;
  public override function onCreate(event:ScriptEvent):Void
  {
	FlxTween.tween(pinkBack, {x: 0}, 0.6, {ease: FlxEase.quartOut});
	add(pinkBack);

	var bitmap = BitmapUtil.scalePartByWidth(Assets.getBitmapData(Paths.image('freeplay/nenecard/bg')), FreeplayState.CUTOUT_WIDTH);
	coolBg = new FlxSprite(0, 0).loadGraphic(bitmap);
	coolBg.scale.x *= 1.05;
	coolBg.visible = false;
	add(coolBg);

	sketchesBack = new FlxBackdrop(Paths.image('freeplay/nenecard/sketches'), 0x10);
	sketchesBack.setPosition(-5, 0);
	sketchesBack.alpha = .4;
	sketchesBack.scale.set(1.2 * (coolBg.width / 511), 1.2 * (coolBg.width / 511));
	sketchesBack.updateHitbox();
	sketchesBack.alpha = 0;
	sketchesBack.velocity.y = -30;
	add(sketchesBack);

	sketchesFront = new FlxBackdrop(Paths.image('freeplay/nenecard/sketches'), 0x10);
	sketchesFront.setPosition(-5, 0);
	sketchesFront.alpha = 1.0;
	sketchesFront.scale.set(1.1 * (coolBg.width / 511), 1.1 * (coolBg.width / 511));
	sketchesFront.updateHitbox();
	sketchesFront.y += FlxG.random.float(-300, 300);
	sketchesFront.velocity.y = -50;
	sketchesFront.alpha = 0;
	add(sketchesFront);

	var bitmap = BitmapUtil.scalePartByWidth(Assets.getBitmapData(Paths.image('freeplay/nenecard/grad')), FreeplayState.CUTOUT_WIDTH);
	grad = new FlxSprite(0, 40).loadGraphic(bitmap);
	grad.visible = true;
	grad.alpha = 0;
	add(grad);

	seal = new FlxSprite(-330, 325);
	seal.frames = Paths.getSparrowAtlas('freeplay/nenecard/seal');
	seal.animation.addByPrefix("y", "SEAL ANIM", 24, false);
	//seal.animation.play("y", true);
	seal.animation.onFinish.add((name:String) -> sealTimer = FlxG.random.float(10, 20));
	seal.animation.onFinish.add((name:String) -> seal.visible = false);
	seal.scale.set((coolBg.width / 511), (coolBg.width / 511));
	seal.flipX = FlxG.random.bool(50);
	seal.alpha = 0;
	add(seal);
  }

