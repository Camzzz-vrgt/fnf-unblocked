import flixel.FlxG;
import flixel.FlxSprite;
import flixel.addons.display.FlxRuntimeShader;
import flixel.sound.FlxSound;
import funkin.Conductor;
import funkin.modding.base.ScriptedFlxRuntimeShader;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import flixel.util.FlxTimer;
import funkin.graphics.shaders.AdjustColorShader;
import funkin.play.PlayState;
import funkin.play.stage.Stage;
import funkin.graphics.adobeanimate.FlxAtlasSprite;
import funkin.modding.base.ScriptedFlxAtlasSprite;
import funkin.Conductor;
import funkin.graphics.FunkinSprite;
import funkin.graphics.adobeanimate.FlxAtlasSprite;
import funkin.modding.base.ScriptedFlxRuntimeShader;
import funkin.modding.events.ScriptEvent;
import flixel.group.FlxTypedSpriteGroup;

class NothingStageErect extends Stage
{
	// Thank you volv.dev for the better petals!!
    function new()
    {
        super('theNothingWorldErect');

    }

    var colorShader:AdjustColorShader;

    function buildStage()
    {
        super.buildStage();

		var pentagram = getNamedProp('seleverPentagram');
        pentagram.alpha = 0;

    }

    override function addCharacter(character:BaseCharacter, charType:CharacterType):Void {
		//this applies a color changing shader to ALL the characters at once
		super.addCharacter(character, charType);
		trace('Applied stage shader to ' + character.characterName);

		shader = new AdjustColorShader();

    	shader.hue = -13;
		shader.saturation = 10;
		shader.contrast = 17;
		shader.brightness = 14;

		character.shader = shader;

	}

	function onBeatHit(event:SongTimeScriptEvent)
	{
		super.onBeatHit(event);
		var pentagram = getNamedProp('seleverPentagram');
		if(PlayState.instance.currentSong.id.toLowerCase() == 'casanova'){
			switch(event.beat){
				case -1:
					FlxTween.angle(pentagram, 0, 360, 2);
					pentagram.alpha = 1;
				case 0:
					FlxTween.tween(pentagram, {alpha: 0}, 0.2);
			}
		}
	}

}
