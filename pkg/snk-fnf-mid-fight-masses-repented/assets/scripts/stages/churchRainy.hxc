import flixel.FlxG;
import flixel.FlxSprite;
import flixel.math.FlxMath;
import flixel.addons.display.FlxRuntimeShader;
import flixel.sound.FlxSound;
import funkin.Conductor;
import flixel.util.FlxSave;
import funkin.modding.base.ScriptedFlxRuntimeShader;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import funkin.util.FlxTweenUtil;
import flixel.util.FlxTimer;
import funkin.play.PlayState;
import funkin.play.stage.Stage;
import funkin.graphics.adobeanimate.FlxAtlasSprite;
import funkin.modding.base.ScriptedFlxAtlasSprite;
import funkin.graphics.shaders.OverlayBlend;
import funkin.graphics.shaders.RuntimeRainShader;
import openfl.filters.ShaderFilter;
import openfl.filters.BlurFilter;
import flixel.addons.display.FlxTiledSprite;
import flixel.addons.display.FlxBackdrop;
import funkin.graphics.shaders.AdjustColorShader;
import funkin.modding.base.ScriptedFlxRuntimeShader;
import flixel.group.FlxTypedSpriteGroup;
import funkin.Conductor;
import funkin.graphics.FunkinSprite;
import funkin.graphics.adobeanimate.FlxAtlasSprite;
import funkin.modding.base.ScriptedFlxRuntimeShader;
import funkin.modding.events.ScriptEvent;

class churchRainyStage extends Stage
{
    function new()
    {
        super('churchRainy');
		// var save = new FlxSave();
		// save.bind("mid-fight-masses-repented", "genzu");
		// if(save.data.disableShaders == null)
		// 	disableShaders = false;
		// else
		// 	disableShaders = save.data.disableShaders;
		// trace("Disable Shaders: " + save.data.disableShaders);
		// save.close();
    }
	var rainShader:RuntimeRainShader = new RuntimeRainShader();
	var rainShaderFilter:ShaderFilter;

	var rainShaderStartIntensity:Float;
	var rainShaderEndIntensity:Float;

	var petalsBeat:float = 4;
	var petalsOffset = FlxG.random.int(12, 12);
	var zDove = 375;
	var colorShader:AdjustColorShader;

	var disableShaders = false;

	override function onCreate(event:ScriptEvent):Void
		{
			super.onCreate(event);
			// Disables the Rain if shaders are off.
			if(!disableShaders){
				rainShader.scale = FlxG.height / 200; // adjust this value so that the rain looks nice

				FlxG.console.registerObject("rainShader", rainShader);
				switch (PlayState.instance.currentSong.id)
				{
					case "worship":
						rainShaderStartIntensity = 0;
						rainShaderEndIntensity = 0.24;
				}

				rainShader.intensity = rainShaderStartIntensity;

				// set the shader input
				//rainShader.mask = frameBufferMan.getFrameBuffer("mask");
				//rainShader.lightMap = frameBufferMan.getFrameBuffer("lightmap");

				rainShaderFilter = new ShaderFilter(rainShader);
				FlxG.camera.filters = [rainShaderFilter];
				//FlxG.camera.setFilters([new openfl.filters.BlurFilter(16,16)]);
			}

		}

	var mist0:FlxBackdrop;
	var mist1:FlxBackdrop;
	var mist2:FlxBackdrop;
	var mist3:FlxBackdrop;
	var mist4:FlxBackdrop;
	var mist5:FlxBackdrop;

	public static var MAX_PETALS:Int = 900;
	// How fast the petals will move.
	public static var WIND_INTENSITY:Float = 0.6;
	// The spread of how the petals move across the screen;
	public static var PETAL_SPREAD_MULT:Float = 1.5;


    var petalsGrp:FlxTypedSpriteGroup<FlxSprite>;
    var builtStage:Bool = false;

	var petalsMoving:Array<Int> = [];
    override function onStepHit(event:SongTimeScriptEvent) {
        super.onStepHit(event);
		//Only Create Petals if Shaders are Enabled
		if(!disableShaders){
			if (!builtStage) return;
			var index = FlxG.random.int(0, MAX_PETALS-1);
			if (!petalsMoving.contains(index) && FlxG.random.bool(10)) {
				// trace(index);

				var offsetX = FlxG.random.int(-100, 200);
				var offsetY = FlxG.random.int(-150, 450);
				FlxTween.quadMotion(petalsGrp.members[index],
					offsetX + petalsGrp.x,
					offsetY + petalsGrp.y,
					FlxG.width / 2 * (FlxG.random.float(0.85, 2.1) * PETAL_SPREAD_MULT) + petalsGrp.x,
					FlxG.height  * (FlxG.random.float(0.85, 2.1) * PETAL_SPREAD_MULT) + petalsGrp.y,
					(FlxG.width * 2.4) + offsetX + petalsGrp.x + (3500 * WIND_INTENSITY),  // this is how far the petals go
					(FlxG.height / 1.3 * PETAL_SPREAD_MULT) + offsetY + petalsGrp.y,
					(1.5 + FlxG.random.float(0.9, 1.4)) / WIND_INTENSITY,
					true,
					{
						onComplete: function(twn) {
							petalsMoving.remove(index);
						}
				}).start();
				petalsMoving.push(index);
			}
		}

    }

    function buildStage()
    {
        super.buildStage();

		// trace('BUILT STAGE!!');

		if(disableShaders == false){
			petalsGrp = new FlxTypedSpriteGroup(-3000, -1500, MAX_PETALS);
			petalsGrp.zIndex = 650;

			for (i in 0...MAX_PETALS) {
				var newPetal:FunkinSprite = FunkinSprite.createSparrow(0, 0, 'stages/church/petals/petals');
				newPetal.animation.addByPrefix('idle', (i + 1) % 6 + '0', 24, true);
				newPetal.animation.play('idle', true);
				petalsGrp.add(newPetal);
			}
			PlayState.instance.currentStage.add(petalsGrp, 'stages/church/petals/petals');
			PlayState.instance.currentStage.refresh(); // Apply z-index.
		}
        builtStage = true;

		// petals
		if(!disableShaders){
			mist0 = new FlxBackdrop(Paths.image('stages/church/rainy/mistMid'), 0x01);
			mist0.setPosition(-650, -200);
			mist0.scrollFactor.set(1.2, 1.2);
			mist0.zIndex = 1000;
			mist0.blend = 0;
			mist0.color = 0xFF5c5c5c;
			mist0.alpha = 0.6;
			mist0.velocity.x = 172;

			PlayState.instance.currentStage.add(mist0);
			PlayState.instance.currentStage.refresh(); // Apply z-index.

			mist1 = new FlxBackdrop(Paths.image('stages/church/rainy/mistMid'), 0x01);
			mist1.setPosition(-650, -200);
			mist1.scrollFactor.set(1.1, 1.1);
			mist1.zIndex = 1000;
			mist1.blend = 0;
			mist1.color = 0xFF5c5c5c;
			mist1.alpha = 0.6;
			mist1.velocity.x = 150;

			PlayState.instance.currentStage.add(mist1);
			PlayState.instance.currentStage.refresh(); // Apply z-index.

			mist2 = new FlxBackdrop(Paths.image('stages/church/rainy/mistBack'), 0x01);
			mist2.setPosition(-650, -200);
			mist2.scrollFactor.set(1.2, 1.2);
			mist2.zIndex = 1001;
			mist2.blend = 0;
			mist2.color = 0xFF5c5c5c;
			mist2.alpha = 0.8;
			mist2.velocity.x = -80;

			PlayState.instance.currentStage.add(mist2);
			PlayState.instance.currentStage.refresh(); // Apply z-index.

			mist3 = new FlxBackdrop(Paths.image('stages/church/rainy/mistMid'), 0x01);
			mist3.setPosition(-650, -200);
			mist3.scrollFactor.set(0.95, 0.95);
			mist3.zIndex = 99;
			mist3.blend = 0;
			mist3.color = 0xFF5c5c5c;
			mist3.alpha = 0.5;
			mist3.velocity.x = -50;
			mist3.scale.set(0.8, 0.8);

			PlayState.instance.currentStage.add(mist3);
			PlayState.instance.currentStage.refresh(); // Apply z-index.

			mist4 = new FlxBackdrop(Paths.image('stages/church/rainy/mistBack'), 0x01);
			mist4.setPosition(-650, -200);
			mist4.scrollFactor.set(0.8, 0.8);
			mist4.zIndex = 88;
			mist4.blend = 0;
			mist4.color = 0xFF5c5c5c;
			mist4.alpha = 1;
			mist4.velocity.x = 40;
			mist4.scale.set(0.7, 0.7);

			PlayState.instance.currentStage.add(mist4);
			PlayState.instance.currentStage.refresh(); // Apply z-index.

			mist5 = new FlxBackdrop(Paths.image('stages/church/rainy/mistMid'), 0x01);
			mist5.setPosition(-650, -200);
			mist5.scrollFactor.set(0.5, 0.5);
			mist5.zIndex = 39;
			mist5.blend = 0;
			mist5.color = 0xFF5c5c5c;
			mist5.alpha = 1;
			mist5.velocity.x = 20;
			mist5.scale.set(1.1, 1.1);

			PlayState.instance.currentStage.add(mist5);
		}

		PlayState.instance.currentStage.refresh();






        getNamedProp('rainyGradient').blend = 0;
    }

	var rainDropTimer:Float = 0;
	var rainDropWait:Float = 6;
	var _timer:Float = 0;

	override function addCharacter(character:BaseCharacter, charType:CharacterType):Void {
		// Apply the shader automatically to each character as it gets added.
		super.addCharacter(character, charType);
		trace('Applied stage shader to ' + character.characterName);

		shader = new AdjustColorShader();

    	shader.hue = -15;
		shader.saturation = -5;
		shader.contrast = 0;
		shader.brightness = 0;

		character.shader = shader;

	}

	override function onUpdate(event:UpdateScriptEvent)
	{
		super.onUpdate(event);

		if(!disableShaders){
			_timer += event.elapsed;
			mist0.y = -660 + (Math.sin(_timer*0.35)*70);
			mist1.y = -500 + (Math.sin(_timer*0.3)*80);
			mist2.y = -540 + (Math.sin(_timer*0.4)*60);
			mist3.y = -230 + (Math.sin(_timer*0.3)*70);
			mist4.y = -170 + (Math.sin(_timer*0.35)*50);
			mist5.y = -80 + (Math.sin(_timer*0.08)*100);
		}

		if (FlxG.sound.music != null)
		{
			var remappedIntensityValue:Float = FlxMath.remapToRange(Conductor.instance.songPosition, 0, FlxG.sound.music.length, rainShaderStartIntensity, rainShaderEndIntensity);
			rainShader.intensity = remappedIntensityValue;
			rainShader.updateViewInfo(FlxG.width, FlxG.height, FlxG.camera);
			rainShader.update(event.elapsed);
		}
		else
		{
			rainShader.intensity = rainShaderStartIntensity;
			rainShader.updateViewInfo(FlxG.width, FlxG.height, FlxG.camera);
			rainShader.update(event.elapsed);
		}



	}


	override function onGameOver(event:ScriptEvent):Void {
		super.onGameOver(event);
		// Make it so the rain shader doesn't show over the game over screen
		FlxG.camera.filters = [];
	}

	override function onSongRetry(event:ScriptEvent):Void {
		super.onSongRetry(event);
	}

}
