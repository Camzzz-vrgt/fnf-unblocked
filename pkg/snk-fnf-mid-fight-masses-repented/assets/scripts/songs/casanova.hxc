import funkin.play.song.Song;
import funkin.play.PlayState;
import funkin.Preferences;
import flixel.FlxSprite;
import funkin.graphics.FunkinSprite;
import flixel.FlxG;
import funkin.play.PlayStatePlaylist;
import funkin.audio.FunkinSound;
import funkin.Conductor;
import funkin.data.song.SongRegistry;
import funkin.play.song.Song;
import flixel.tweens.FlxTween;
import flixel.util.FlxTimer;
import funkin.save.Save;
import flixel.tweens.FlxEase;
import funkin.play.stage.StageProp;
import funkin.ui.options.PreferencesMenu;
import funkin.play.cutscene.VideoCutscene;
import funkin.play.cutscene.CutsceneType;

class CasanovaSong extends Song
{
    public function new()
    {
        super('casanova');
    }

	var hasPlayedCutscene:Bool;
	//hasPlayedCutscene variable can only be true or false

  public function listDifficulties(variationId:String, variationIds:Array<String>, showLocked:Bool):Array<String> {
    if (showLocked || Save.instance.hasBeatenLevel('weekchurch')) {
      return super.listDifficulties(variationId, variationIds);
    }
      // Hide all difficulties if the player has not beaten the week.
      return [];
	}

	public override function isSongNew(currentDifficulty:String, currentVariation:String):Bool{
      if (currentVariation == 'pico'){
        return !Save.instance.hasBeatenSong(this.id, null, 'pico');
      }else{
        return false;
      }
      if(currentVariation != 'pico' && currentDifficulty == 'easy' || currentDifficulty == 'normal' || currentDifficulty == 'hard' || currentDifficulty == 'alt'){
        if(Save.instance.hasBeatenSong(this.id, ['easy', 'normal',' hard', 'alt']) == false) return true;
      }else{
        return false;
      }
    }

	public override function onCountdownStart(event:CountdownScriptEvent):Void {
		super.onCountdownStart(event);

    if(!PlayStatePlaylist.isStoryMode)
    {
      trace('Started countdown for Casanova...');

      // Skip the cutscene on the normal variation if we are in Freeplay.
      if (PlayState.instance.currentVariation == 'default' && !PlayStatePlaylist.isStoryMode) hasPlayedCutscene = true;

      if (!hasPlayedCutscene) {
        trace('Pausing countdown to play cutscene.');

        hasPlayedCutscene = true;

        event.cancel(); // CANCEL THE COUNTDOWN!

        startDialogue();
      }
    }
  }
  function startDialogue() {
    var targetDialogue = 'casanova'; //this is in the data/dialogue/conversations folder

    if (PlayState.instance.currentVariation == 'pico') targetDialogue += "-pico";
    if (!Preferences.naughtyness) targetDialogue += "-censored"; //uses a different file wether or not naughtyness is turned off

    trace('Playing dialogue...');
    PlayState.instance.startConversation(targetDialogue);


  }

  public override function onDialogueEnd() {

    Countdown.performCountdown();
  }

  function onSongRetry(event:ScriptEvent)
    {
      super.onSongRetry(event);
		//make sure that when u retry the song, u dont have 2 sit thru the dialogue again
      hasPlayedCutscene = true;
    }

    /**
     * Replay the cutscene after leaving the song.
     */
    function onCreate(event:ScriptEvent):Void
    {
      super.onCreate(event);
      hasPlayedCutscene = false;
    }

    function onBeatHit(event:SongTimeScriptEvent)
    {
      super.onBeatHit(event);
      // trace(PlayState.instance.currentSong.id.toLowerCase());

      var seleverPos:Array<Float> = [PlayState.instance.currentStage.getDad().cameraFocusPoint.x, PlayState.instance.currentStage.getDad().cameraFocusPoint.y];

      // trace(PlayState.instance.currentSong.id.toLowerCase());
      if(event.beat == -1 && PlayState.instance.currentSong.id.toLowerCase() == 'casanova')
      {
        PlayState.instance.currentStage.getDad().playAnimation('EYP', true);
        PlayState.instance.tweenCameraToPosition(seleverPos[0] - 50, seleverPos[1] - 75, 0.5, FlxEase.quadOut);
        PlayState.instance.tweenCameraZoom(1.3, 0.5, true, FlxEase.quadOut);
      }

      if(event.beat == 0 && PlayState.instance.currentSong.id.toLowerCase() == 'casanova')
        {
          PlayState.instance.currentStage.getDad().playAnimation('EYP', true);
          PlayState.instance.tweenCameraZoom(0.6, 0.3, true, FlxEase.quadOut);
        }
    }
}
