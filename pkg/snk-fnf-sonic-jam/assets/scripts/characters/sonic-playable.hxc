import flixel.FlxG;
import funkin.graphics.shaders.AdjustColorShader;
import funkin.play.character.MultiSparrowCharacter;
import funkin.play.GameOverSubState;
import funkin.play.PauseSubState;
import funkin.play.PlayState;
import funkin.util.TouchUtil;

class SonicPlayableCharacter extends MultiSparrowCharacter 
{
	var MAX_IDLE_REPEATS:Int = 9;
	var idles:Int = 0;

	var oldIconChanged:Bool = false;

	var usesWashedAnims:Bool = false;
	
	function new() 
	{
		super('sonic-playable');
	}

	public function onCreate(event:ScriptEvent) 
	{
		super.onCreate(event);

		GameOverSubState.musicSuffix = '-sonic';
		GameOverSubState.blueBallSuffix = '-sonic';

		PauseSubState.musicSuffix = '-sonic';

		// Reset the idle count.
		idles = 0;

		// Only dance if spooky kids are the opponent.
		this.shouldAlternate = false;

		if (PlayState.instance != null)
		{
			this.shouldAlternate = ((PlayState.instance.currentChart?.characters?.opponent ?? "") == "spooky");

			// There should be a 1/1000 chance for Sonic to use his "washed" sprites.
			usesWashedAnims = FlxG.random.bool(1 / 1000 * 100);
		}
	}

	public function onAdd(event:ScriptEvent)
	{
		super.onAdd(event);

		// If using the washed anims, offset Sonic a bit vertically. We also gotta remove Amy and Tails for this.
		if (usesWashedAnims)
		{
			this.y -= 80;
			this.originalPosition.y = this.y;

			PlayState.instance.currentStage?.getGirlfriend()?.kill();
		}
	}

	override public function playAnimation(name:String, restart:Bool = false, ignoreOther:Bool = false, reversed:Bool = false)
	{
		// Use the washed animation suffix if the chance is right and the animation exists.
		var animSuffix:String = "";
		if (usesWashedAnims && this.hasAnimation(name + "-washed")) animSuffix = "-washed";

		// Make sonic bored after 3 idle plays.
		if (name == "idle" && !ignoreOther && this.getCurrentAnimation().indexOf("waiting") < 0) 
		{
			idles++;

			if (idles % MAX_IDLE_REPEATS == 0)
			{
				idles = 0;
				super.playAnimation("waiting" + animSuffix);
				return;
			} 
		}
		else 
		{
			// Reset the idle count if not idling.
			idles = 0;
		}

		super.playAnimation(name + animSuffix, restart, ignoreOther, reversed);
	}

	public function onSongRetry(event:SongRetryEvent)
	{
		super.onSongRetry(event);

		// Restart the idle count. 
		idles = 0;
	}

	public function onUpdate(event:UpdateScriptEvent)
	{
		super.onUpdate(event);

		// Replace the old icon if pressed 9.
		var state:PlayState = PlayState.instance;
		if (state == null) return;

		var mobileTap:Bool = (FlxG.onMobile && TouchUtil.justPressed && TouchUtil.overlapsComplex(state.iconP1));
		if ((FlxG.keys.justPressed.NINE || mobileTap) && state.iconP1 != null) 
		{
			FlxG.signals.postUpdate.addOnce(changeOldIcon);
		}
	}

	public function onCountdownStart(event:CountdownScriptEvent)
	{
		super.onCountdownStart(event);

		// If we're in mainStageErect, tweak the shader values to better suit Sonic.
		// Doing this here instead of in onAdd because shader gets applied after it.
		if (PlayState.instance?.currentStage?.id == "mainStageErect" && Std.isOfType(this.shader, AdjustColorShader))
		{
			this.shader.brightness = -30;
    		this.shader.hue = -12.5;
    		this.shader.contrast = 7;
			this.shader.saturation = 0;
		}
	}

	function changeOldIcon()
	{
		var state:PlayState = PlayState.instance;
		if (state == null) return;

		// If the current icon is bf-old, replace it with the needlemouse icon.
		if (state.iconP1?.characterId == "bf-old")
		{
			if (!oldIconChanged)
			{
				oldIconChanged = true;
				state.iconP1.loadCharacter("needlemouse");
			}
		}
		else
		{
			oldIconChanged = false;
		}
	}
}