import funkin.Conductor;
import funkin.play.PlayState;
import funkin.play.event.ScriptedSongEvent;

class LightFlashEvent extends ScriptedSongEvent
{
  public function new()
  {
    super('lightflash', {processOldEvents: true});
  }

  public override function handleEvent(data):Void
  {
    if (PlayState.instance == null) return;

    var params = data.getArray('params') ?? [];
    var alpha = data.getFloat('alpha') ?? (params.length > 0 ? Std.parseFloat(Std.string(params[0])) : 0.5);
    var durationSteps = data.getFloat('duration') ?? (params.length > 1 ? Std.parseFloat(Std.string(params[1])) : 4);
    var seconds = Conductor.instance.stepLengthMs * durationSteps / 1000;
    var colorAlpha = Std.int(Math.max(0, Math.min(1, alpha)) * 255);
    var color = (colorAlpha << 24) | 0x00FFFFFF;

    PlayState.instance.camHUD.flash(color, seconds);
  }
}
