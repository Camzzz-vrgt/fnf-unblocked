import funkin.play.event.SongEvent;

class CameraTargetEvent extends SongEvent
{
    public override function handleEvent(data) {}
    public function getEventSchema() {
        return [
            { name: "value1", title: "Alvo (bf/dad/gf, vazio=solta)", defaultValue: "", type: "string" },
            { name: "value2", title: "Velocidade ('inst' = instantâneo)", defaultValue: "inst", type: "string" }
        ];
    }
    public function getTitle() { return "Camera Target"; }
    public function new() { super('camera_target'); }
}
