import funkin.play.event.SongEvent;
class ChangeScrollSpeedEvent extends SongEvent
{
    public override function handleEvent(data) {}
    public function getEventSchema() {
        return [
            { name: "value1", title: "Multiplicador", defaultValue: "1", type: "string" },
            { name: "value2", title: "Duração", defaultValue: "0.1", type: "string" }
        ];
    }
    public function getTitle() { return "Change Scroll Speed"; }
    public function new() { super('Change Scroll Speed'); }
}
