import funkin.play.event.SongEvent;
class IconSwitchEvent extends SongEvent
{
    public override function handleEvent(data) {}
    public function getEventSchema() {
        return [ { name: "value1", title: "on / off", defaultValue: "on", type: "string" } ];
    }
    public function getTitle() { return "Icon Switch"; }
    public function new() { super('Icon Switch'); }
}
