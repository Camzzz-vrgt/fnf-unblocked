import funkin.play.event.SongEvent;

class CameraTiltEvent extends SongEvent
{
    public override function handleEvent(data) {}
    public function getEventSchema() {
        return [
            { name: "value1", title: "on / off", defaultValue: "on", type: "string" },
            { name: "value2", title: "(não usado)", defaultValue: "", type: "string" }
        ];
    }
    public function getTitle() { return "Camera Tilt"; }
    public function new() { super('CameraTilt'); }
}
