import funkin.play.event.SongEvent;

class ChangePartEvent extends SongEvent
{
    public override function handleEvent(data) {
        // Função vazia de propósito — quem trata de verdade é o CastleStage.hxc
        // (scripts/stages/), via onSongEvent. Essa classe só existe pra
        // registrar 'Change Part' como um evento válido pro engine reconhecer.
    }

    public function getEventSchema() {
        return [
            {
                name: "value1",
                title: "Parte (1 ou 2)",
                defaultValue: "1",
                type: "string",
            },
            {
                name: "value2",
                title: "(não usado)",
                defaultValue: "",
                type: "string",
            }
        ];
    }

    public function getTitle() {
        return "Change Part";
    }

    public function new() {
        super('Change Part');
    }
}
