import funkin.play.event.SongEvent;

class HideHudEvent extends SongEvent
{
    public override function handleEvent(data) {}

    public function getEventSchema() {
        return [
            {
                name: "value1",
                title: "O quê (strums / all)",
                defaultValue: "all",
                type: "string",
            },
            {
                name: "value2",
                title: "0 = esconder, outro = mostrar",
                defaultValue: "0",
                type: "string",
            }
        ];
    }

    public function getTitle() {
        return "Hide Hud";
    }

    public function new() {
        super('Hide Hud');
    }
}
