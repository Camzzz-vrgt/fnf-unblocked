import funkin.play.event.SongEvent;
class CameraSwitchNoHudEvent extends SongEvent
{
    public override function handleEvent(data) {}
    public function getEventSchema() {
        return [
            { name: "value1", title: "Velocidade", defaultValue: "0.5", type: "string" },
            { name: "value2", title: "on / off", defaultValue: "on", type: "string" }
        ];
    }
    public function getTitle() { return "Camera Switch no HUD"; }
    public function new() { super('Camera Switch no HUD'); }
}
