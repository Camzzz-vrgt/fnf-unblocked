import flixel.tweens.FlxEase;
import openfl.display.BlendMode;


var solo_time_d = new FunkinSprite(0, 0, Paths.animateAtlas('stages/mainStageAmTake/solotime_cardboard', 'shared'));
var blackAss = new FunkinSprite();
var ver = new FunkinSprite();


//var bfRim:DropShadowShader;
//var dadRim:DropShadowShader;

