function onLoadSong()
{
	var play = PlayState.instance;
	if (play == null || play.currentSong == null || play.currentSong.id != "fresh" || play.currentStage == null)
		return;
	var currentStage = play.currentStage;

	trace('[Fresh] scene script initialized');
	blackAss.makeGraphic(1, 1, FlxColor.WHITE);
	blackAss.color = FlxColor.BLACK;
	blackAss.scale.set(2000, 2000);
	blackAss.updateHitbox();
	blackAss.screenCenter();
	blackAss.zIndex = 9000;
	blackAss.alpha = 0;
	currentStage.add(blackAss);

	ver.loadGraphic(Paths.image('stages/mainStageAmTake/gf_event', 'shared'));
	ver.zIndex = currentStage.getGirlfriend().zIndex - 1;
	ver.x = 520;
	ver.y = -580;
	ver.visible = false;
	ver.y -= 800;
	currentStage.add(ver);

	solo_time_d.zIndex = 8;
	solo_time_d.anim.addByFrameLabel("off", "off loop", 24, false);
	solo_time_d.anim.addByFrameLabel("turn", "turned on", 24, false);
	solo_time_d.anim.addByFrameLabel("on", "on loop", 24, false);
	solo_time_d.anim.onFinish.add((animName) -> if (animName == "turn") solo_time_d.anim.play('on', true));
	solo_time_d.anim.play('off', true);
	solo_time_d.applyStageMatrix = true;
	currentStage.add(solo_time_d);

	solo_time_d.x += 325;
	solo_time_d.y -= 350;

	solo_time_d.y -= 800;

	currentStage.refresh();

	var gf = currentStage.getGirlfriend();
	gf.anim.onFrameChange.add((name, symb, idx) -> if (name == "fresh solo") {
		trace(symb, idx);
		switch (symb)
		{
		
			case 1:
				ver.visible = true;
				FlxTween.tween(ver, {y: ver.y + 800}, 6, {startDelay: 6, ease: FlxEase.cubeOut});

			case 333:
				ver.zIndex = currentStage.getGirlfriend().zIndex + 1;
				currentStage.refresh();

			case 369:
				ver.zIndex = currentStage.getGirlfriend().zIndex - 1;
				currentStage.refresh();

			case 371:
				ver.y += 2;
			case 377:
				ver.y += 2;
			case 379:
				ver.y += 5;

			case 381:
				ver.y -= 5;
			case 383:
				ver.y -= 4;

			case 387:
				ver.zIndex = 12;
				currentStage.refresh();

			case 389:
				FlxTween.tween(ver, {y: ver.y - 800}, 4, {ease: FlxEase.cubeIn});
		}
	});
}

function onBeatHit(event)
{
	var play = PlayState.instance;
	if (play == null || play.currentSong == null || play.currentSong.id != "fresh" || play.currentStage == null)
		return;
	var beat = event.beat;
	var currentStage = play.currentStage;

	if (beat == 108)
	{
		var dad = currentStage.getDad();
		dad.zIndex = 9999;
		currentStage.refresh();
		blackAss.alpha = 1;
		FlxTween.tween(dad, {alpha: 0}, 0.8, {startDelay: 1.2, ease: FlxEase.cubeOut});
	}

	if (beat == 112)
	{
		FlxTween.cancelTweensOf(currentStage.getDad());
		currentStage.getDad().alpha = 1;
		var vin2 = currentStage.getNamedProp('vin2');
		vin2.alpha = 1;

		var dad = currentStage.getDad();
		dad.zIndex = 20;
		currentStage.refresh();
		blackAss.alpha = 1;
		FlxTween.tween(blackAss, {alpha: 0}, 7, {ease: FlxEase.smootherStepInOut});
		FlxTween.tween(vin2, {alpha: 0.8}, 12, {ease: FlxEase.smootherStepInOut});
	}


	if (beat == 116)
		moveIn();

	if (beat == 128)
	{
		FlxTween.tween(solo_time_d, {y: solo_time_d.y + 800}, 4, {ease: FlxEase.sineOut});
	}

	if (beat == 143)
	{
		solo_time_d.anim.play('turn', true);
		FlxTween.tween(solo_time_d, {y: solo_time_d.y - 800}, 7, {startDelay: 12, ease: FlxEase.sineIn});
	}

	if (beat == 144)
	{
		var vin2 = currentStage.getNamedProp('vin2');
		vin2.alpha = 0;

		blackAss.color = FlxColor.WHITE;
		blackAss.blend = BlendMode.ADD;
		blackAss.alpha = 1;
		FlxTween.tween(blackAss, {alpha: 0}, 1.2, {ease: FlxEase.sineOut});

	}

	if (beat == 174)
		moveOut();
}

function moveIn()
{
	var play = PlayState.instance;
	if (play == null) return;

    FlxTween.tween(play.opponentStrumline, {x: play.opponentStrumline.x - 100, alpha: 0.75}, 12.25, {ease: FlxEase.sineOut});
    FlxTween.num(play.opponentStrumline.strumlineScale.x, .65, 12.25, {ease: FlxEase.sineOut}, (value:Float) -> play.opponentStrumline.strumlineScale.set(value, value));

    FlxTween.tween(play.playerStrumline, {x: play.playerStrumline.x - FlxG.width/4 + 20}, 14.55, {ease: FlxEase.sineInOut});
    FlxTween.num(play.playerStrumline.strumlineScale.x, 1.1, 14.55, {ease: FlxEase.sineInOut}, (value:Float) -> play.playerStrumline.strumlineScale.set(value, value));
}

function moveOut()
{
	var play = PlayState.instance;
	if (play == null) return;

    FlxTween.tween(play.opponentStrumline, {x: play.opponentStrumline.x + 100, alpha: 1}, 2.65, {ease: FlxEase.backOut});
    FlxTween.num(play.opponentStrumline.strumlineScale.x,1, 2.65, {ease: FlxEase.backOut}, (value:Float) -> play.opponentStrumline.strumlineScale.set(value, value));

    FlxTween.tween(play.playerStrumline, {x: play.playerStrumline.x + FlxG.width/4 - 20}, 2.45, {ease: FlxEase.cubeOut});
    FlxTween.num(play.playerStrumline.strumlineScale.x, 1, 2.45, {ease: FlxEase.cubeOut}, (value:Float) -> play.playerStrumline.strumlineScale.set(value, value));
}
