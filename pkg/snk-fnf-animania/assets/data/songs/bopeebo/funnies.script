var weDoALittleThnigie:Bool = false;
function onBeatHit(beat)
{
	if (currentSong.id != "bopeebo")
		return;

	if (weDoALittleThnigie)
	{
		Modchart.set("scale", 1.1, "player");
		Modchart.ease("scale", 0.95, Conductor.instance.songPosition, Conductor.instance.beatLengthMs, FlxEase.sineOut, "player");
	}

	if (beat == 96)
	{
		moveIn(); weDoALittleThnigie = true;
		var vin2 = currentStage.getNamedProp('vin2');
		FlxTween.tween(vin2, {alpha: 0.6}, .25 , {ease: FlxEase.cubeIn, onComplete: _ -> FlxTween.tween(vin2, {alpha: 0}, 9, {ease: FlxEase.sineInOut})});

		var aa = Preferences.downscroll ? 1 : -1;
		FlxTween.tween(camHUD, {scrollAngle: -2, "scroll.y": -15 * aa}, 17, {ease: FlxEase.sineInOut});
		FlxTween.tween(PlayState.instance, {defaultHUDCameraZoom: 0.75}, 13, {startDelay: 5, ease: FlxEase.sineInOut});
		Modchart.ease("bump", .75, Conductor.instance.songPosition, 16000, FlxEase.sineInOut, "player");
		Modchart.ease("tanWave", 1.25, Conductor.instance.songPosition, 16000, FlxEase.sineInOut, "player");
	}

	if (beat == 128)
	{
		FlxTween.tween(camHUD, {scrollAngle: 0, "scroll.y": 0}, .6, {ease: FlxEase.cubeOut});
		FlxTween.cancelTweensOf(PlayState.instance, ["defaultHUDCameraZoom"]);
		PlayState.instance.defaultHUDCameraZoom = 1;
		moveOut(); weDoALittleThnigie = false;
		Modchart.ease("bump", 0, Conductor.instance.songPosition, 800, FlxEase.circOut, "player");
		Modchart.ease("tanWave", 0, Conductor.instance.songPosition, 800, FlxEase.circOut, "player");
		Modchart.ease("scale", 1, Conductor.instance.songPosition, 800, FlxEase.circOut, "player");
	}

	if (beat == 131)
	{
		disableKeys = true;
		Modchart.clear("player");
	}

	if (beat == 132)
		FlxTween.tween(playerStrumline, {alpha: 0.1}, .15, {ease: FlxEase.sineOut});


	if (beat == 135)
	{
		disableKeys = false;
		playerStrumline.strumlineNotes.members[2].playStatic();
		FlxTween.tween(playerStrumline, {alpha: 1}, .5, {ease: FlxEase.sineInOut});
	}
}

function moveIn()
{
	var offset = (Preferences.downscroll ? -300 : 300);

	//for (item in healthBarGroup.members)
	//	FlxTween.tween(item, {y: item.y + offset}, 10, {ease: FlxEase.sineInOut});

	FlxTween.tween(healthBarGroup, {y: healthBarGroup.y + offset, alpha: 0}, 6.26, {ease: FlxEase.sineInOut});

	FlxTween.tween(opponentStrumline, {y: opponentStrumline.y + 25, alpha: 0.75}, 14, {ease: FlxEase.sineInOut});
	FlxTween.num(opponentStrumline.strumlineScale.x, .9, 14, {ease: FlxEase.sineInOut}, (value:Float) -> opponentStrumline.changeMode(false, value));

	FlxTween.tween(playerStrumline, {x: playerStrumline.x - 150}, 16, {ease: FlxEase.sineInOut});
	FlxTween.num(playerStrumline.strumlineScale.x, 1.075, 16, {ease: FlxEase.sineInOut}, (value:Float) -> playerStrumline.changeMode(false, value));
}

function moveOut()
{
	var offset = (Preferences.downscroll ? -300 : 300);

	//for (item in healthBarGroup.members)
	//	FlxTween.tween(item, {y: item.y - offset}, .26, {ease: FlxEase.sineInOut});

	FlxTween.tween(healthBarGroup, {y: healthBarGroup.y - offset, alpha: 1}, .26, {ease: FlxEase.sineInOut});


    FlxTween.tween(opponentStrumline, {y: opponentStrumline.y - 25, alpha: 1}, 1, {ease: FlxEase.backOut});
    FlxTween.num(opponentStrumline.strumlineScale.x, 1, 1, {ease: FlxEase.backOut}, (value:Float) -> opponentStrumline.changeMode(false, value));

    FlxTween.tween(playerStrumline, {x: playerStrumline.x + 150}, 1, {ease: FlxEase.cubeOut});
    FlxTween.num(playerStrumline.strumlineScale.x, 1, 1, {ease: FlxEase.cubeOut}, (value:Float) -> playerStrumline.changeMode(false, value));
}

